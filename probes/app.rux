<!-- Tracer, Phase 0: one page per question Tracer has to answer about Rux
     before the real app is built. What to do on each page, and what to write
     down, is in PROBES.md. -->
<template>
  <screen class="app" @key="onKey(event)" @close="onClose()">
    <view class="nav">
      <text class="brand">Tracer · probes</text>
      <view
        class="link"
        r-for="p in probes"
        r-key="p.path"
        :to="p.path"
        :class="{ on: route == p.path }">
        <text class="link-no">{{ p.no }}</text>
        <text class="link-label">{{ p.label }}</text>
      </view>
      <text class="hint">Ctrl+K: palette (probe 6)</text>
    </view>
    <view class="stage">
      <router>
        <route path="/" view="events-probe" />
        <route path="/json" view="json-probe" />
        <route path="/http" view="http-probe" />
        <route path="/chart" view="chart-probe" />
        <route path="/proc" view="proc-probe" />
        <route path="/shell" view="shell-probe" />
        <route fallback view="events-probe" />
      </router>
    </view>
  </screen>
</template>

<style>
  * { box-sizing: border-box; }

  .app {
    display: flex;
    height: 100vh;
    background: #141414;
    font-family: sans-serif;
    color: #d4d4d4;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 220px;
    padding: 16px 10px;
    background: #1b1b1b;
    border-right: 1px solid #2a2a2a;
  }

  .brand { color: #f0f0f0; font-size: 15px; font-weight: 700; padding: 0 8px 14px 8px; }

  .link {
    display: flex;
    gap: 10px;
    padding: 8px;
    border-radius: 6px;
    cursor: pointer;
  }

  .link:hover { background: #242424; }
  .link.on { background: #2b2540; }
  .link-no { color: #7c6cf0; font-size: 13px; font-weight: 700; width: 14px; }
  .link-label { color: #d4d4d4; font-size: 13px; }
  .hint { color: #6a6a6a; font-size: 11px; margin-top: auto; padding: 8px; }

  .stage {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: auto;
  }
</style>

<script>
  use pages::events_probe;
  use pages::json_probe;
  use pages::http_probe;
  use pages::chart_probe;
  use pages::proc_probe;
  use pages::shell_probe;
  use stores::ui;
  use native::proc;

  let probes = [
    { no: "1", path: "/", label: "Ordered events" },
    { no: "2", path: "/json", label: "Large response body" },
    { no: "3", path: "/http", label: "Real HTTP request" },
    { no: "4", path: "/chart", label: "Live chart" },
    { no: "5", path: "/proc", label: "Child process" },
    { no: "6", path: "/shell", label: "Workbench shell" }
  ];

  fn onKey(e) {
    if e.primary && e.key == "k" {
      // Drop the caret first, so the palette's autofocus input takes it.
      blur();
      ui.togglePalette();
      return false;
    }
    if e.key == "Escape" && ui.palette {
      ui.closePalette();
      return false;
    }
  }

  // Probe 5: the window owns a child process, as Tracer's window will own the
  // core. Both hooks write to the probe log, so the log says which ran.
  fn onClose() {
    proc.stopChild("@close");
    true
  }

  unmounted {
    proc.stopChild("unmounted");
  }
</script>
