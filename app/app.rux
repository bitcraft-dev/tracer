<!-- Tracer's window: a client of the workspace's core, like the CLI.
     It holds nothing about requests that the core did not tell it: saved
     requests, history, responses and who is connected all come from the
     core, its list and its event stream, so what `tracer save` or an agent
     does shows up here as well. -->
<template>
    <screen class="app" @key="onKey(event)" @close="onClose()">
        <view class="main">
            <view class="rail">
                <text class="logo">T</text>
                <view class="rail-item" :class="{ on: mode == &quot;rest&quot; && !gql && !wsMode }" @tap="toRest()"><text class="rail-label">REST</text></view>
                <view class="rail-item" :class="{ on: mode == &quot;rest&quot; && gql }" @tap="toGraphql()"><text class="rail-label">GraphQL</text></view>
                <view class="rail-item" :class="{ on: mode == &quot;rest&quot; && wsMode }" @tap="toRealtime()"><text class="rail-label">Realtime</text></view>
                <view class="rail-item" :class="{ on: mode == &quot;bench&quot; }" @tap="mode = &quot;bench&quot;"><text class="rail-label">Bench</text></view>
            </view>

            <view class="side" :style="`width: ${sideWidth}px`">
                <view class="env-row">
                    <view class="env">
                        <input type="select" r-model="envPick" :options="envOptions" />
                    </view>
                    <view class="gear" @tap="openEnvEditor()"><text class="gear-t">⚙</text></view>
                </view>
                <text class="empty warn" r-for="w in envSkipped">skipped {{ w }}</text>
                <view class="side-h">
                    <text class="side-title">Collections</text>
                    <text class="count">{{ saved.length }}</text>
                    <view class="side-add" @tap="newRequest()"><text class="side-add-t">+</text></view>
                </view>
                <view class="list">
                    <text class="empty" r-if="saved.length == 0">No saved requests yet. Ctrl+S saves the one you're editing.</text>
                    <view
                        class="row"
                        r-for="s in saved"
                        r-key="s.path"
                        :class="{ on: s.path == openPath }"
                        @tap="openSaved(s.path)">
                        <view class="row-top">
                            <text class="m" :style="`color: ${methodColor(s.method)}`">{{ s.method }}</text>
                            <text class="row-url">{{ nameOf(s.path) }}</text>
                        </view>
                        <view class="row-bottom" r-if="folderOf(s.path) != &quot;&quot;">
                            <text class="st"></text>
                            <text class="who">{{ folderOf(s.path) }}</text>
                        </view>
                    </view>
                    <text class="empty warn" r-for="w in skipped">skipped {{ w }}</text>
                </view>

                <view class="side-h second">
                    <text class="side-title">History</text>
                    <text class="count">{{ if filtering { `${shown.length} of ${requests.length}` } else { `${requests.length}` } }}</text>
                    <view class="side-add" r-if="filtering" @tap="clearFilter()"><text class="clear-t">clear</text></view>
                </view>
                <view class="hfilter">
                    <view class="hsearch">
                        <input r-model="hq" placeholder="Search URL, status, who, env, #id" />
                    </view>
                    <view class="hpicks">
                        <view class="hpick"><input type="select" r-model="hActor" :options="actorKinds" /></view>
                        <view class="hpick"><input type="select" r-model="hStatus" :options="statusClasses" /></view>
                    </view>
                </view>
                <view class="list">
                    <text class="empty" r-if="requests.length == 0">Nothing yet. Send a request, or run tracer send in this workspace.</text>
                    <text class="empty" r-if="requests.length > 0 && shown.length == 0">No request matches the filter.</text>
                    <view
                        class="row"
                        r-for="r in shown"
                        r-key="r.id"
                        :class="{ on: r.id == selected }"
                        @tap="selected = r.id">
                        <view class="row-top">
                        <text class="m" :style="`color: ${methodColor(r.method)}`">{{ r.method }}</text>
                        <text class="row-url">{{ r.url }}</text>
                        </view>
                        <view class="row-bottom">
                        <text class="st" :style="`color: ${statusColor(r)}`">{{ statusText(r) }}</text>
                        <text class="who">{{ r.actorKind }} · {{ r.actor }}</text>
                        <text class="env-tag" r-if="r.env != &quot;&quot;">{{ r.env }}</text>
                        <text class="again" r-if="r.rerunOf > 0">↻ #{{ r.rerunOf }}</text>
                        <text class="when">{{ when(r.atMs) }}</text>
                        </view>
                    </view>
                </view>
            </view>

            <view class="split-v" @drag="resizeSide(event)"><view class="grip-v"></view></view>

            <view class="work">
                <view class="ask" r-for="r in waiting" r-key="r.id">
                <view class="ask-top">
                    <text class="ask-who">{{ r.actor }} asks to send</text>
                    <text class="m" :style="`color: ${methodColor(r.method)}`">{{ r.method }}</text>
                    <text class="ask-url">{{ r.url }}</text>
                    <text class="env-tag" r-if="r.env != &quot;&quot;">{{ r.env }}</text>
                </view>
                <view class="ask-bottom">
                    <text class="ask-why">#{{ r.id }} · {{ r.reason }}</text>
                    <view class="link" @tap="selected = r.id"><text class="link-t">Show</text></view>
                    <view class="link danger-l" @tap="decide(r.id, false)"><text class="link-t">Refuse</text></view>
                    <view class="allow" @tap="decide(r.id, true)"><text class="allow-t">Allow</text></view>
                </view>
                </view>
                <view class="title">
                    <text class="title-t" :class="{ unsaved: openPath == &quot;&quot; }">{{ if openPath == "" { "Unsaved request" } else { openPath } }}</text>
                    <text class="dirty" r-if="dirty">●</text>
                    <text class="notice" r-if="notice != &quot;&quot;">{{ notice }}</text>
                    <view class="save" @tap="save()"><text class="save-t">Save</text></view>
                </view>
                <view class="bar">
                    <view class="method" r-if="!gql">
                        <input type="select" r-model="method" :options="methods" />
                    </view>
                    <view class="method gql-m" r-if="gql"><text class="gql-t">GraphQL</text></view>
                    <view class="url">
                        <input r-model="url" placeholder="https://…" />
                    </view>
                    <view class="send" r-if="!running()" :class="{ off: !connected }" @tap="send()">
                        <text class="send-label">Send</text>
                    </view>
                    <view class="send stop" r-if="running()" @tap="cancel()">
                        <text class="send-label">{{ if streamOpen() { "Close" } else { "Cancel" } }}</text>
                    </view>
                </view>
                <view class="preview" r-if="url.includes(&quot;{{&quot;)">
                    <text class="preview-t">{{ preview }}</text>
                    <text class="preview-warn" r-if="preview.includes(&quot;{{&quot;)">{{ previewWarning() }}</text>
                </view>

                <view class="tabs">
                    <view class="tab" r-if="!gql" :class="{ on: reqTab == &quot;body&quot; }" @tap="reqTab = &quot;body&quot;">
                        <text class="tab-label">{{ if wsMode { "Messages" } else { "Body" } }}</text>
                    </view>
                    <view class="tab" r-if="gql" :class="{ on: reqTab == &quot;query&quot; }" @tap="reqTab = &quot;query&quot;">
                        <text class="tab-label">Query</text>
                    </view>
                    <view class="tab" r-if="gql" :class="{ on: reqTab == &quot;vars&quot; }" @tap="reqTab = &quot;vars&quot;">
                        <text class="tab-label">Variables</text>
                        <text class="badge" r-if="gqlVars.trim() != &quot;&quot;">JSON</text>
                    </view>
                    <view class="tab" :class="{ on: reqTab == &quot;headers&quot; }" @tap="reqTab = &quot;headers&quot;">
                        <text class="tab-label">Headers</text>
                        <text class="badge" r-if="sentHeaders().length > 0">{{ sentHeaders().length }}</text>
                    </view>
                    <view class="tab" :class="{ on: reqTab == &quot;checks&quot; }" @tap="reqTab = &quot;checks&quot;">
                        <text class="tab-label">Checks</text>
                        <text class="badge" r-if="checkLines() > 0">{{ checkLines() }}</text>
                    </view>
                </view>
                <view class="editor" :style="`height: ${reqHeight}px`">
                    <input r-if="reqTab == &quot;body&quot; && !gql && !wsMode" type="textarea" r-model="body" placeholder="request body (not sent with GET or HEAD when empty)" />
                    <input r-if="reqTab == &quot;body&quot; && wsMode" type="textarea" r-model="body" placeholder="messages to send once it's open, each after a line of ===; a line of === wait-for-server waits for the server first" />
                    <input r-if="reqTab == &quot;query&quot; && gql" type="textarea" r-model="gqlQuery" placeholder="query { … } or mutation { … }; the Schema view lists what the server has" />
                    <input r-if="reqTab == &quot;vars&quot; && gql" type="textarea" r-model="gqlVars" placeholder="the query's variables as a JSON object, such as { &quot;id&quot;: 7 }" />
                    <input r-if="reqTab == &quot;headers&quot;" type="textarea" r-model="headerText" placeholder="Name: value, one per line" />
                    <input r-if="reqTab == &quot;checks&quot;" type="textarea" r-model="checksText" placeholder="one per line: status 2xx · $.id == 1 · header Content-Type contains json · time &lt; 500 · len($.items) &gt;= 3" />
                </view>
                <text class="error" r-if="error != &quot;&quot;">{{ error }}</text>
                <view class="split-h" @drag="resizeReq(event)"><view class="grip-h"></view></view>

                <view class="res">
                    <view class="tabs" r-if="mode == &quot;rest&quot; && gql">
                        <view class="tab" :class="{ on: gqlView == &quot;response&quot; }" @tap="gqlView = &quot;response&quot;">
                            <text class="tab-label">Response</text>
                        </view>
                        <view class="tab" :class="{ on: gqlView == &quot;schema&quot; }" @tap="gqlView = &quot;schema&quot;">
                            <text class="tab-label">Schema</text>
                            <text class="badge" r-if="schema != none">{{ schema.types.length }}</text>
                        </view>
                    </view>
                    <view class="schema" r-if="mode == &quot;rest&quot; && gql && gqlView == &quot;schema&quot;">
                        <view class="schema-h">
                            <view class="link" @tap="loadSchema()"><text class="link-t">{{ if schema == none { "Load the schema" } else { "Load again" } }}</text></view>
                            <view class="hsearch grow"><input r-model="schemaQ" placeholder="Filter types and fields" /></view>
                            <text class="count" r-if="schema != none">{{ shownTypes.length }} of {{ schema.types.length }}</text>
                        </view>
                        <text class="empty" r-if="schemaNote != &quot;&quot;">{{ schemaNote }}</text>
                        <view class="gtype" r-for="t in shownTypes" r-key="t.name">
                            <view class="gtype-h">
                                <text class="gkind">{{ t.kind }}</text>
                                <text class="gname">{{ t.name }}</text>
                                <text class="groot" r-if="t.name == queryRoot || t.name == mutationRoot">{{ if t.name == queryRoot { "queries" } else { "mutations" } }}</text>
                            </view>
                            <text class="gdesc" r-if="t.description != &quot;&quot;">{{ t.description }}</text>
                            <view class="gfield" r-for="f in t.fields">
                                <text class="gf-n">{{ f.name }}</text>
                                <text class="gf-a" r-if="f.args != &quot;&quot;">{{ f.args }}</text>
                                <text class="gf-t">{{ f.ty }}</text>
                            </view>
                            <text class="gvals" r-if="t.values != &quot;&quot;">{{ t.values }}</text>
                        </view>
                    </view>
                    <text class="empty" r-if="showRes && sel == none">Pick a request in History, or send one.</text>
                    <view class="res-in" r-if="showRes && sel != none">
                        <view class="res-h">
                            <text class="res-id">#{{ sel.id }}</text>
                            <text class="m" :style="`color: ${methodColor(sel.method)}`">{{ sel.method }}</text>
                            <text class="res-url">{{ sel.url }}</text>
                            <view class="link" @tap="copySelCurl()"><text class="link-t">cURL</text></view>
                            <view class="link" @tap="editPast()"><text class="link-t">Edit</text></view>
                            <view class="link" r-if="sel.state != &quot;running&quot;" @tap="rerun()"><text class="link-t">Re-run</text></view>
                        </view>
                        <view class="chips">
                            <text class="chip" :style="`color: ${statusColor(sel)}`">{{ statusText(sel) }}</text>
                            <view class="chip link-chip" r-if="sel.rerunOf > 0" @tap="selected = sel.rerunOf">
                                <text class="link-t">re-run of #{{ sel.rerunOf }}</text>
                            </view>
                            <text class="chip" r-if="sel.env != &quot;&quot;">env {{ sel.env }}</text>
                            <text class="chip" r-if="sel.flow > 0">flow {{ sel.flow }}</text>
                            <view class="chip link-chip" r-if="sel.bench > 0" @tap="showBench(sel.bench)">
                                <text class="link-t">first of bench {{ sel.bench }}</text>
                            </view>
                            <text class="chip" r-if="sel.stream != &quot;&quot; && !sel.open">{{ streamText(sel) }}</text>
                            <text class="chip" r-if="sel.state == &quot;done&quot; || sel.stream != &quot;&quot;">TTFB {{ sel.ttfbMs.round() }} ms</text>
                            <text class="chip" r-if="sel.state == &quot;done&quot;">Total {{ sel.totalMs.round() }} ms</text>
                            <text class="chip" r-if="sel.state == &quot;done&quot;">{{ size(sel.size) }}</text>
                            <text class="chip">by {{ sel.actorKind }} · {{ sel.actor }}</text>
                            <text class="chip">sent {{ when(sel.atMs) }}</text>
                            </view>
                            <view class="fall" r-if="(sel.state == &quot;done&quot; || sel.stream != &quot;&quot;) && sel.dnsMs >= 0.0">
                                <view class="fall-bar">
                                    <view class="fall-seg" r-for="p in phases(sel)" :style="`flex-grow: ${p.ms}; background: ${p.color}`"></view>
                                </view>
                                <view class="fall-keys">
                                    <view class="fall-key" r-for="p in phases(sel)">
                                    <view class="fall-dot" :style="`background: ${p.color}`"></view>
                                    <text class="fall-t">{{ p.name }} {{ ms(p.ms) }}</text>
                                    </view>
                                </view>
                            </view>
                            <view class="tabs">
                                <view class="tab" :class="{ on: resTab == &quot;body&quot; }" @tap="resTab = &quot;body&quot;">
                                    <text class="tab-label">Body</text>
                                </view>
                                <view class="tab" :class="{ on: resTab == &quot;headers&quot; }" @tap="resTab = &quot;headers&quot;">
                                    <text class="tab-label">Headers</text>
                                    <text class="badge">{{ sel.resHeaders.length }}</text>
                                </view>
                                <view class="tab" r-if="sel.results.length > 0" :class="{ on: resTab == &quot;checks&quot; }" @tap="resTab = &quot;checks&quot;">
                                    <text class="tab-label">Checks</text>
                                    <text class="badge" :class="{ bad: failedChecks(sel) > 0 }">{{ sel.results.length - failedChecks(sel) }}/{{ sel.results.length }}</text>
                                </view>
                                <view class="tab" r-if="sel.stream != &quot;&quot;" :class="{ on: resTab == &quot;messages&quot; }" @tap="resTab = &quot;messages&quot;">
                                    <text class="tab-label">Messages</text>
                                    <text class="badge">{{ selMsgs.length }}</text>
                                </view>
                            </view>
                            <view class="pane">
                            <text class="mono err" r-if="sel.state == &quot;failed&quot;">{{ sel.error }}</text>
                            <text class="mono dim" r-if="sel.state == &quot;running&quot; && sel.stream == &quot;&quot;">waiting for the answer…</text>
                            <text class="mono warn-t" r-if="sel.state == &quot;approval&quot;">waiting for a person to allow it: {{ sel.reason }}. Nothing has been sent.</text>
                            <text class="mono dim" r-if="sel.state == &quot;cancelled&quot;">cancelled by {{ sel.cancelledBy }}</text>
                            <view class="viewer" r-if="sel.state == &quot;done&quot; && resTab == &quot;body&quot;">
                                <text class="mono dim" r-if="sel.size == 0">(empty body)</text>
                                <text class="mono err" r-if="viewError != &quot;&quot;">{{ viewError }}</text>
                                <view class="ln" r-for="l in bodyLines" r-key="l.no">
                                    <text class="ln-no">{{ l.no }}</text>
                                    <view class="fold" @tap="toggleFold(l.no)">
                                        <text class="fold-t">{{ if l.folds == 0 { "" } else if l.folded { "▸" } else { "▾" } }}</text>
                                    </view>
                                    <text class="code" :style="`padding-left: ${l.indent * 16}px`"><text class="j-key">{{ l.key }}</text><text :class="`j-${l.kind}`">{{ l.value }}</text><text class="j-note">{{ if l.note == "" { "" } else { `  ${l.note}` } }}</text></text>
                                </view>
                                <view class="more" r-if="viewVisible > bodyLines.length">
                                    <text class="mono dim">{{ bodyLines.length }} of {{ viewVisible }} lines</text>
                                    <view class="link" @tap="showMore()"><text class="link-t">Show {{ Math.min(VIEW_STEP, viewVisible - bodyLines.length) }} more</text></view>
                                </view>
                            </view>
                            <view class="check" r-if="resTab == &quot;checks&quot;" r-for="c in sel.results">
                                <text class="check-mark" :class="{ bad: !c.pass }">{{ if c.pass { "✓" } else { "✗" } }}</text>
                                <text class="check-e">{{ c.expect }}</text>
                                <text class="check-a">found {{ c.actual }}</text>
                            </view>
                            <view class="stream" r-if="resTab == &quot;messages&quot; && sel.stream != &quot;&quot;">
                                  <view class="compose" r-if="sel.stream == &quot;websocket&quot; && sel.open">
                                       <view class="hsearch grow"><input r-model="wsText" placeholder="a message to send, Enter" @key="wsKey(event)" /></view>
                                       <view class="link" @tap="sendWs()"><text class="link-t">Send</text></view>
                                  </view>
                                  <text class="mono dim" r-if="!sel.open && sel.closedWhy != &quot;&quot;">{{ sel.closedWhy }} · {{ sel.msgIn }} in, {{ sel.msgOut }} out</text>
                                  <text class="mono dim" r-if="selMsgs.length == 0">nothing yet</text>
                                  <text class="mono dim" r-if="selMsgsAll > selMsgs.length">the newest {{ selMsgs.length }} of {{ selMsgsAll }}</text>
                                  <view class="msg" r-for="m in selMsgs" r-key="m.n">
                                       <text class="msg-d" :class="{ out: m.dir == &quot;out&quot; }">{{ if m.dir == "in" { "↓" } else { "↑" } }}</text>
                                       <text class="msg-n">{{ m.n }}</text>
                                       <text class="msg-at">{{ clock(m.atMs) }}</text>
                                       <text class="msg-ev" r-if="m.event != &quot;&quot;">{{ m.event }}</text>
                                       <text class="msg-by" r-if="m.dir == &quot;out&quot;">{{ m.by }}</text>
                                       <text class="msg-t" :class="{ bin: m.binary }">{{ m.text }}</text>
                                  </view>
                            </view>
                            <view class="hdr" r-if="(sel.state == &quot;done&quot; || sel.stream != &quot;&quot;) && resTab == &quot;headers&quot;" r-for="h in sel.resHeaders">
                                <text class="hdr-n">{{ h.name }}</text>
                                <text class="hdr-v">{{ h.value }}</text>
                            </view>
                        </view>
                    </view>
                    <view class="bench" r-if="mode == &quot;bench&quot;">
                        <view class="bench-form">
                        <view class="bf"><text class="bf-l">Requests</text><view class="bf-in"><input r-model="bTotal" placeholder="none" /></view></view>
                        <view class="bf"><text class="bf-l">At a time</text><view class="bf-in"><input r-model="bConc" placeholder="10" /></view></view>
                        <view class="bf"><text class="bf-l">Seconds</text><view class="bf-in"><input r-model="bSecs" placeholder="no limit" /></view></view>
                        <view class="bf"><text class="bf-l">Per second</text><view class="bf-in"><input r-model="bRate" placeholder="any" /></view></view>
                        <view class="send" r-if="!benchRunning" :class="{ off: !connected }" @tap="runBench()">
                            <text class="send-label">Run bench</text>
                        </view>
                        <view class="send stop" r-if="benchRunning" @tap="stopBench()">
                            <text class="send-label">Stop</text>
                        </view>
                        </view>
                        <text class="empty" r-if="bn == none">Sends the request above over and over: Requests in all, At a time in flight, for at most Seconds, no faster than Per second. Its first request goes to History with its waterfall; the rest are counted here.</text>
                        <view class="bench-in" r-if="bn != none">
                        <view class="res-h">
                            <text class="res-id">bench {{ benchId }}</text>
                            <text class="m" :style="`color: ${methodColor(benchMethod)}`">{{ benchMethod }}</text>
                            <text class="res-url">{{ benchUrl }}</text>
                        </view>
                        <view class="chips">
                            <text class="chip" :style="`color: ${benchColor()}`">{{ benchState() }}</text>
                            <text class="chip">{{ benchPlan }}</text>
                            <text class="chip" r-if="benchEnv != &quot;&quot;">env {{ benchEnv }}</text>
                            <text class="chip">by {{ benchBy }}</text>
                        </view>
                        <view class="fall-bar">
                            <view class="fall-seg" :style="`flex-grow: ${benchShare()}; background: #7c6cf0`"></view>
                            <view class="fall-seg" :style="`flex-grow: ${1.0 - benchShare()}; background: #262626`"></view>
                        </view>
                        <view class="tiles">
                            <view class="tile"><text class="tile-v">{{ bn.done }}</text><text class="tile-l">done</text></view>
                            <view class="tile"><text class="tile-v">{{ bn.perSec.toFixed(1) }}</text><text class="tile-l">a second</text></view>
                            <view class="tile"><text class="tile-v">{{ ms(bn.p50Ms) }}</text><text class="tile-l">p50</text></view>
                            <view class="tile"><text class="tile-v">{{ ms(bn.p95Ms) }}</text><text class="tile-l">p95</text></view>
                            <view class="tile"><text class="tile-v">{{ ms(bn.p99Ms) }}</text><text class="tile-l">p99</text></view>
                            <view class="tile"><text class="tile-v">{{ ms(bn.maxMs) }}</text><text class="tile-l">max</text></view>
                            <view class="tile"><text class="tile-v" :class="{ bad: bn.wrong > 0 }">{{ bn.wrong }}</text><text class="tile-l">wrong</text></view>
                        </view>
                        <view class="plots">
                            <view class="plot-box">
                            <text class="sub">Requests a second · top {{ rpsTop().round() }}</text>
                            <view class="plot"><path class="line" :d="rpsPath()" /></view>
                            </view>
                            <view class="plot-box grow">
                            <text class="sub">Latency · {{ bn.histogram.reduce((a, n) => a + n, 0) }} answers</text>
                            <view class="hist">
                                <view class="hcol" r-for="b in bars()">
                                <text class="hn">{{ if b.n > 0 { `${b.n}` } else { "" } }}</text>
                                <view class="hbar" :style="`height: ${b.h}px`"></view>
                                <text class="hl">{{ b.label }}</text>
                                </view>
                            </view>
                            </view>
                        </view>
                        <text class="mono" r-if="bn.statuses != &quot;&quot;">status {{ bn.statuses }}</text>
                        <text class="mono err" r-for="x in bn.errors">no answer: {{ x }}</text>
                        <text class="mono warn-t" r-if="bn.rate != &quot;&quot;">rate {{ bn.rate }}</text>
                        <view class="cmp-bar" r-if="!benchRunning">
                             <view class="bf-in"><input r-model="baselineName" placeholder="main" /></view>
                             <view class="link" @tap="saveBaseline()"><text class="link-t">Save as baseline</text></view>
                             <text class="sub">compare with</text>
                             <view class="cmp-pick"><input type="select" r-model="compareWith" :options="compareOptions" /></view>
                             <view class="link" @tap="compareNow()"><text class="link-t">Compare</text></view>
                        </view>
                        <text class="mono dim" r-if="cmpNote != &quot;&quot;">{{ cmpNote }}</text>
                        <view class="cmp" r-if="cmpFor == benchId && cmpRows.length > 0">
                             <view class="cmp-row">
                                  <text class="cmp-l"></text>
                                  <text class="cmp-v head">{{ cmpBefore }}</text>
                                  <text class="cmp-v head">{{ cmpAfter }}</text>
                                  <text class="cmp-c head">change</text>
                             </view>
                             <view class="cmp-row" r-for="d in cmpRows">
                                  <text class="cmp-l">{{ d.label }}</text>
                                  <text class="cmp-v">{{ d.before }}</text>
                                  <text class="cmp-v">{{ d.after }}</text>
                                  <text class="cmp-c" :class="{ bad: d.worse, good: d.better }">{{ d.change }}{{ if d.worse { " ✗" } else if d.better { " ✓" } else { "" } }}</text>
                             </view>
                             <text class="mono dim" r-for="n in cmpNotes">note: {{ n }}</text>
                             <text class="mono" :class="{ err: cmpRegressed }">{{ cmpVerdict }}</text>
                        </view>
                        </view>
                        <view class="until-h">
                            <text class="side-title">Until n in a row</text>
                        </view>
                        <view class="bench-form">
                        <view class="bf"><text class="bf-l">In a row</text><view class="bf-in"><input r-model="uStreak" placeholder="3" /></view></view>
                        <view class="bf wide"><text class="bf-l">Counting</text><view class="bf-in"><input r-model="uMatch" placeholder="failures, or status == 401" /></view></view>
                        <view class="bf"><text class="bf-l">At most</text><view class="bf-in"><input r-model="uMax" placeholder="1000" /></view></view>
                        <view class="bf"><text class="bf-l">Apart, ms</text><view class="bf-in"><input r-model="uGap" placeholder="0" /></view></view>
                        <view class="send" r-if="!untilRunning" :class="{ off: !connected }" @tap="runUntil()">
                            <text class="send-label">Run until</text>
                        </view>
                        <view class="send stop" r-if="untilRunning" @tap="stopUntil()">
                            <text class="send-label">Stop</text>
                        </view>
                        </view>
                        <text class="empty" r-if="untilId == 0">Sends the request above again and again, one at a time, until In a row answers in a row count: failures, or with Counting, answers that pass it (status == 401, status 5xx, $.error == locked). Any other answer starts the count again. Every send goes to History.</text>
                        <view class="bench-in" r-if="untilId != 0">
                        <view class="res-h">
                            <text class="res-id">until {{ untilId }}</text>
                            <text class="m" :style="`color: ${methodColor(untilMethod)}`">{{ untilMethod }}</text>
                            <text class="res-url">{{ untilUrl }}</text>
                        </view>
                        <view class="chips">
                            <text class="chip" :style="`color: ${untilColor()}`">{{ untilState() }}</text>
                            <text class="chip">{{ untilPlan }}</text>
                            <text class="chip" r-if="untilEnv != &quot;&quot;">env {{ untilEnv }}</text>
                            <text class="chip">by {{ untilBy }}</text>
                        </view>
                        <view class="tiles">
                            <view class="tile"><text class="tile-v">{{ untilSent }}</text><text class="tile-l">sent</text></view>
                            <view class="tile"><text class="tile-v" :class="{ bad: untilStreak > 0 }">{{ untilStreak }}</text><text class="tile-l">in a row</text></view>
                        </view>
                        <view class="u-row" r-for="a in untilAnswers" r-key="a.id" @tap="openAnswer(a.id)">
                            <text class="u-id">#{{ a.id }}</text>
                            <text class="u-mark" :class="{ on: a.counted }">{{ if a.counted { "●" } else { "·" } }}</text>
                            <text class="u-end">{{ answerText(a.id) }}</text>
                            <text class="u-streak">{{ a.streak }} in a row</text>
                        </view>
                        </view>
                    </view>
                </view>
            </view>
        </view>

        <view class="status">
            <text class="dot" :style="`color: ${linkColor()}`">●</text>
            <text class="status-t">{{ linkText() }}</text>
            <text class="status-t">env: {{ if envPick == NO_ENV { "none" } else { envPick } }}</text>
            <text class="status-t dim">{{ tracer.link?.workspace ?? "" }}</text>
            <text class="status-t right">{{ clients.length }} connected · event {{ lastSeq }}</text>
            <text class="status-t flow-t" r-if="lastFlow != &quot;&quot;" :class="{ bad: !flowOk }">{{ lastFlow }}</text>
            <text class="status-t flow-t" r-if="lastBench != &quot;&quot;" :class="{ bad: !benchOk }" @tap="showBench(benchId)">{{ lastBench }}</text>
            <text class="status-t policy-bad" r-if="policyError != &quot;&quot;">{{ policyError }}</text>
            <view class="browser-chip" :class="{ on: browserOn || browserOrigin != &quot;&quot; }" @tap="openBrowser()">
                <text class="browser-t">{{ browserLabel() }}</text>
            </view>
            <view class="agents" :class="{ off: !agentsOn }" @tap="setAgents(!agentsOn)">
                <text class="agents-t">{{ if agentsOn { "agents on" } else { "agents off" } }}</text>
            </view>
            <text class="status-t key">Ctrl+K</text>
        </view>

        <view class="scrim" r-if="browserOpen" @tap="browserOpen = false">
        <view class="palette" @tap="noop()">
            <text class="prompt-h">Browser behaviour</text>
            <text class="sub">Off, Tracer sends what it's given and nothing else. For the whole workspace, whoever sends.</text>
            <view class="b-row" @tap="bCookies = !bCookies">
                <text class="b-box">{{ if bCookies { "☑" } else { "☐" } }}</text>
                <text class="b-t">Keep cookies and send them back, as a browser does</text>
            </view>
            <text class="sub">Page origin, blank for none</text>
            <view class="pal-field small"><input r-model="bOrigin" placeholder="https://app.example.com" /></view>
            <text class="sub">As from a page there: Origin is sent to other origins, a request a browser would preflight goes after its OPTIONS (in History), and the answer gets a CORS check.</text>
            <view class="b-actions">
                <text class="mono err" r-if="browserError != &quot;&quot;">{{ browserError }}</text>
                <view class="save" @tap="saveBrowser()"><text class="save-t">Save</text></view>
            </view>
            <text class="prompt-h">Cookies · {{ jar.length }}</text>
            <text class="empty" r-if="jar.length == 0">The jar is empty.</text>
            <view class="c-row" r-for="c in jar" r-key="`${c.domain}${c.path} ${c.name}`">
                <text class="c-where">{{ c.domain }}{{ c.path }}</text>
                <text class="c-kv">{{ c.name }}={{ c.value }}</text>
                <text class="c-meta">{{ c.flags }} {{ cookieEnds(c.expiresMs) }}</text>
            </view>
            <view class="b-actions" r-if="jar.length > 0">
                <view class="link danger" @tap="clearJar()"><text class="link-t">Clear all</text></view>
            </view>
        </view>
        </view>

        <view class="scrim" r-if="naming" @tap="naming = false">
        <view class="palette" @tap="noop()">
            <text class="prompt-h">Save as</text>
            <view class="pal-field">
                <input r-model="saveName" placeholder="folder/name, such as albums/get album" autofocus @key="nameKey(event)" />
            </view>
            <text class="prompt-hint">requests/{{ saveName }}.http · Enter saves · Esc cancels</text>
        </view>
        </view>

        <view class="scrim" r-if="editingEnvs" @tap="editingEnvs = false">
        <view class="envpanel" @tap="noop()">
            <view class="envlist">
            <text class="prompt-h">Environments</text>
            <view
                class="row"
                r-for="e in envs"
                r-key="e.name"
                :class="{ on: e.name == editEnv }"
                @tap="pickEnv(e.name)">
                <text class="row-url">{{ e.name }}</text>
            </view>
            <view class="pal-field small">
                <input r-model="newEnvName" placeholder="new environment, Enter" @key="newEnvKey(event)" />
            </view>
            </view>
            <view class="envbody">
            <text class="empty" r-if="editEnv == &quot;&quot;">Pick an environment, or name a new one.</text>
            <view class="envbody-in" r-if="editEnv != &quot;&quot;">
                <view class="envbody-h">
                <text class="prompt-h">{{ editEnv }}</text>
                <view class="link danger" @tap="deleteEnv()"><text class="link-t">Delete</text></view>
                </view>
                <text class="sub">Variables · environments/{{ editEnv }}.env</text>
                <view class="var" r-for="v in draftVars" r-key="v.id">
                <view class="vf name"><input r-model="v.name" placeholder="name" /></view>
                <view class="vf grow"><input r-model="v.value" placeholder="value" /></view>
                <view class="x" @tap="removeVar(v.id)"><text class="x-t">✕</text></view>
                </view>
                <view class="envbody-h">
                <view class="link" @tap="addVar()"><text class="link-t">+ variable</text></view>
                <view class="save" @tap="saveEnv()"><text class="save-t">Save variables</text></view>
                </view>
                <text class="sub">Secrets · kept out of git; values never shown or sent to clients</text>
                <view class="var" r-for="name in editSecrets" r-key="name">
                <text class="secret-n">{{ name }}</text>
                <text class="secret-v">••••••</text>
                <view class="x" @tap="removeSecret(name)"><text class="x-t">✕</text></view>
                </view>
                <view class="var">
                <view class="vf name"><input r-model="secretName" placeholder="name" /></view>
                <view class="vf grow"><input r-model="secretValue" placeholder="value (replaces one of that name)" /></view>
                <view class="link" @tap="setSecret()"><text class="link-t">Set</text></view>
                </view>
            </view>
            </view>
        </view>
        </view>

        <view class="scrim" r-if="palette" @tap="closePalette()">
        <view class="palette" @tap="noop()">
            <view class="pal-field">
            <input r-model="search" placeholder="Type a command…" autofocus @key="paletteKey(event)" />
            </view>
            <view
            class="cmd"
            r-for="(c, i) in hits"
            r-key="c.id"
            :class="{ on: i == pick }"
            @tap="run(c.id)">
            <text class="cmd-label">{{ c.label }}</text>
            <text class="cmd-hint">{{ c.hint }}</text>
            </view>
            <text class="empty" r-if="hits.length == 0">No command matches</text>
        </view>
        </view>
    </screen>
</template>

<style>
  * { box-sizing: border-box; }

  .app {
    /* Rux's own dropdown and selection toolbar follow the root's scheme. */
    color-scheme: dark;
    display: flex;
    flex-direction: column;
    height: 100vh;
    background: #141414;
    font-family: sans-serif;
    color: #d4d4d4;
  }

  .main { flex: 1; display: flex; min-height: 0; }

  .rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    width: 64px;
    padding: 12px 0;
    background: #181818;
    border-right: 1px solid #262626;
  }

  .logo {
    color: #7c6cf0;
    font-size: 18px;
    font-weight: 700;
    padding-bottom: 10px;
  }

  .rail-item { padding: 8px 6px; border-radius: 6px; }
  .rail-item.on { background: #2b2540; }
  .rail-label { color: #e0e0e0; font-size: 11px; font-weight: 700; }

  /* The remembered width gives way before the work area does: in a
     narrow window the sidebar shrinks to 200px, the work area keeps 420px. */
  .side {
    display: flex;
    flex-direction: column;
    flex-shrink: 1;
    min-width: 200px;
    background: #1b1b1b;
  }

  /* Drag handles: a wide target with a thin line, lit while hovered. */
  .split-v {
    display: flex;
    justify-content: center;
    width: 7px;
    flex-shrink: 0;
    cursor: col-resize;
  }

  .grip-v { width: 1px; background: #262626; }
  .split-v:hover .grip-v { width: 3px; background: #7c6cf0; }

  .split-h {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 9px;
    flex-shrink: 0;
    cursor: row-resize;
  }

  .grip-h { height: 1px; background: #262626; }
  .split-h:hover .grip-h { height: 3px; background: #7c6cf0; }

  .side-h {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 14px 14px 10px 14px;
  }

  .side-title { color: #f0f0f0; font-size: 13px; font-weight: 700; }

  .count {
    color: #8a8a8a;
    font-size: 11px;
    padding: 1px 6px;
    background: #262626;
    border-radius: 8px;
  }

  .side-h.second { border-top: 1px solid #262626; }

  .env {
    display: flex;
    align-items: center;
    height: 34px;
    margin: 12px 10px 2px 10px;
    padding: 0 10px;
    background: #141414;
    border: 1px solid #2e2e2e;
    border-radius: 6px;
  }

  .env-row {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 12px 10px 2px 10px;
  }

  .env-row .env { flex: 1; margin: 0; }
  .gear { padding: 4px 8px; border-radius: 6px; cursor: pointer; }
  .gear:hover { background: #2b2540; }
  .gear-t { color: #9d8ff5; font-size: 16px; }

  .envpanel {
    display: flex;
    width: 760px;
    height: 460px;
    background: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 10px;
  }

  .envlist {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 200px;
    padding: 12px;
    border-right: 1px solid #2e2e2e;
    overflow-y: auto;
  }

  .envbody {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    overflow-y: auto;
  }

  .envbody-in { display: flex; flex-direction: column; gap: 6px; }
  .envbody-h { display: flex; align-items: center; gap: 8px; }
  .envbody-h .save { margin-left: auto; }
  .sub { color: #7a7a7a; font-size: 11px; padding-top: 10px; }
  .var { display: flex; align-items: center; gap: 6px; }

  .vf {
    display: flex;
    align-items: center;
    height: 30px;
    padding: 0 8px;
    background: #141414;
    border: 1px solid #2e2e2e;
    border-radius: 5px;
  }

  .vf.name { width: 160px; }
  .vf.grow { flex: 1; min-width: 0; }
  .x { padding: 2px 6px; border-radius: 4px; cursor: pointer; }
  .x:hover { background: #3a2626; }
  .x-t { color: #8a8a8a; font-size: 12px; }
  .link { padding: 3px 8px; border-radius: 4px; cursor: pointer; }
  .link:hover { background: #2b2540; }
  .link-t { color: #9d8ff5; font-size: 12px; font-weight: 700; }
  .link.danger { margin-left: auto; }
  .link.danger .link-t { color: #f0716c; }

  .secret-n {
    width: 176px;
    color: #d4d4d4;
    font-size: 12px;
    font-family: monospace;
  }

  .secret-v {
    flex: 1;
    color: #7a7a7a;
    font-size: 12px;
    font-family: monospace;
  }

  .pal-field.small { height: 30px; margin-top: 8px; }

  .env-tag {
    color: #9d8ff5;
    font-size: 10px;
    padding: 0 5px;
    border: 1px solid #3a3550;
    border-radius: 4px;
  }

  .side-add {
    margin-left: auto;
    padding: 0 8px;
    border-radius: 4px;
    cursor: pointer;
  }

  .side-add:hover { background: #2b2540; }
  .side-add-t { color: #9d8ff5; font-size: 16px; font-weight: 700; }

  .list {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 8px 8px 8px;
    overflow-y: auto;
  }

  .empty { color: #6a6a6a; font-size: 12px; padding: 8px; }
  .empty.warn { color: #e8a54b; font-family: monospace; font-size: 11px; }

  .row {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 7px 8px;
    border-radius: 6px;
    cursor: pointer;
  }

  .row:hover { background: #232323; }
  .row.on { background: #2b2540; }
  .row-top { display: flex; gap: 8px; }
  .row-bottom { display: flex; gap: 8px; }

  .m {
    font-size: 11px;
    font-weight: 700;
    font-family: monospace;
    width: 64px;
  }

  .row-url {
    flex: 1;
    color: #d4d4d4;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .st { font-size: 11px; font-family: monospace; width: 64px; }

  .who {
    color: #7a7a7a;
    font-size: 11px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .work {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px;
    min-width: 420px;
  }

  .title {
    display: flex;
    gap: 8px;
    align-items: center;
    min-height: 26px;
  }

  .title-t {
    color: #e0e0e0;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .title-t.unsaved { color: #8a8a8a; font-weight: 400; }
  .dirty { color: #e8a54b; font-size: 10px; }

  .notice {
    flex: 1;
    min-width: 0;
    color: #e8a54b;
    font-size: 12px;
    overflow-wrap: break-word;
  }

  .save {
    margin-left: auto;
    padding: 4px 14px;
    border: 1px solid #3a3550;
    border-radius: 6px;
    cursor: pointer;
  }

  .save:hover { background: #2b2540; }
  .save-t { color: #c8c0f8; font-size: 12px; font-weight: 700; }
  .bar { display: flex; gap: 8px; align-items: center; }

  .method, .url {
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 10px;
    background: #1b1b1b;
    border: 1px solid #2e2e2e;
    border-radius: 6px;
  }

  .method { flex: 0 1 140px; min-width: 96px; }
  .url { flex: 1; min-width: 0; }

  .send {
    padding: 9px 26px;
    background: #7c6cf0;
    border-radius: 6px;
    cursor: pointer;
  }

  .send:hover { background: #8f81f5; }
  .send.off { background: #3a3550; }
  .send.stop { background: #8a3a38; }
  .send.stop:hover { background: #a04542; }
  .send-label { color: #ffffff; font-size: 14px; font-weight: 700; }

  .preview {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: -4px;
    padding: 0 2px;
  }

  .preview-t {
    flex: 1;
    min-width: 0;
    color: #8a8a8a;
    font-size: 12px;
    font-family: monospace;
    word-break: break-all;
  }

  .preview-warn { color: #e8a54b; font-size: 11px; white-space: nowrap; }
  .tabs { display: flex; gap: 18px; border-bottom: 1px solid #262626; }

  .tab {
    display: flex;
    gap: 6px;
    align-items: center;
    padding: 6px 0;
    cursor: pointer;
    border-bottom: 2px solid #141414;
  }

  .tab.on { border-bottom: 2px solid #7c6cf0; }
  .tab-label { color: #9a9a9a; font-size: 13px; }
  .tab.on .tab-label { color: #f0f0f0; }

  .badge {
    color: #9a9a9a;
    font-size: 10px;
    padding: 0 5px;
    background: #262626;
    border-radius: 6px;
  }

  .editor {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    padding: 8px 10px;
    background: #1b1b1b;
    border: 1px solid #2e2e2e;
    border-radius: 6px;
  }

  .error { color: #f0716c; font-size: 12px; font-family: monospace; }

  .res {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .res-in {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-height: 0;
  }

  .res-h { display: flex; gap: 8px; align-items: center; }

  .res-url {
    flex: 1;
    min-width: 0;
    color: #c8c8c8;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .res-id { color: #7a7a7a; font-size: 11px; font-family: monospace; }
  .link-chip { cursor: pointer; padding: 2px 9px; }
  .link-chip:hover { background: #2b2540; }

  .hfilter {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 10px 8px 10px;
  }

  .hsearch, .hpick {
    display: flex;
    align-items: center;
    height: 30px;
    padding: 0 8px;
    background: #141414;
    border: 1px solid #2e2e2e;
    border-radius: 5px;
  }

  .hpicks { display: flex; gap: 6px; }
  .hpick { flex: 1; min-width: 0; }
  .clear-t { color: #9d8ff5; font-size: 11px; }
  .again { color: #7a7a7a; font-size: 10px; font-family: monospace; }

  .when {
    margin-left: auto;
    color: #6a6a6a;
    font-size: 10px;
    font-family: monospace;
    white-space: nowrap;
  }

  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .check { display: flex; gap: 10px; align-items: baseline; }

  .check-mark {
    width: 14px;
    color: #4ec98f;
    font-size: 12px;
    font-family: monospace;
  }

  .check-mark.bad { color: #f0716c; }
  .check-e { color: #d4d4d4; font-size: 12px; font-family: monospace; }

  .check-a {
    flex: 1;
    min-width: 0;
    color: #7a7a7a;
    font-size: 12px;
    font-family: monospace;
  }

  .badge.bad { color: #f0716c; }
  .fall { display: flex; flex-direction: column; gap: 6px; }

  .fall-bar {
    display: flex;
    gap: 1px;
    height: 8px;
    border-radius: 2px;
    overflow: hidden;
  }

  .fall-seg { flex-basis: 0; flex-shrink: 1; min-width: 2px; }
  .fall-keys { display: flex; flex-wrap: wrap; gap: 4px 14px; }
  .fall-key { display: flex; align-items: center; gap: 5px; }
  .fall-dot { width: 8px; height: 8px; border-radius: 2px; }
  .fall-t { color: #9a9a9a; font-size: 11px; font-family: monospace; }

  .chip {
    padding: 3px 9px;
    border: 1px solid #333333;
    border-radius: 4px;
    font-size: 12px;
    color: #c8c8c8;
  }

  .pane {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 12px;
    background: #0e0e0e;
    border: 1px solid #262626;
    border-radius: 6px;
    overflow-y: auto;
  }

  .mono {
    color: #d4d4d4;
    font-size: 12px;
    font-family: monospace;
    white-space: pre-wrap;
  }


  .viewer {
    display: flex;
    flex-direction: column;
  }

  .ln {
    display: flex;
  }

  .ln-no {
    width: 40px;
    flex-shrink: 0;
    padding-right: 6px;
    color: #4a4a4a;
    font-size: 12px;
    font-family: monospace;
    text-align: right;
  }

  .fold {
    width: 14px;
    flex-shrink: 0;
    cursor: pointer;
  }

  .fold-t {
    color: #7a7a7a;
    font-size: 11px;
    font-family: monospace;
  }

  .code {
    flex: 1;
    min-width: 0;
    color: #d4d4d4;
    font-size: 12px;
    font-family: monospace;
    white-space: pre-wrap;
  }

  .j-key {
    color: #9cdcfe;
  }

  .j-string {
    color: #ce9178;
  }

  .j-number {
    color: #b5cea8;
  }

  .j-bool {
    color: #569cd6;
  }

  .j-null {
    color: #c586c0;
  }

  .j-punct {
    color: #d4d4d4;
  }

  .j-plain {
    color: #d4d4d4;
  }

  .j-note {
    color: #6a6a6a;
  }

  .more {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 8px;
  }

  .mono.err { color: #f0716c; }
  .dim { color: #6a6a6a; }
  .hdr { display: flex; gap: 12px; }

  .hdr-n {
    flex: 0 1 220px;
    min-width: 110px;
    color: #9d8ff5;
    font-size: 12px;
    font-family: monospace;
    overflow-wrap: break-word;
  }

  .hdr-v {
    flex: 1;
    min-width: 0;
    overflow-wrap: break-word;
    color: #d4d4d4;
    font-size: 12px;
    font-family: monospace;
  }

  .ask {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px 12px;
    background: #2a2416;
    border: 1px solid #6b5426;
    border-radius: 8px;
  }

  .ask-top, .ask-bottom { display: flex; gap: 8px; align-items: center; }

  .ask-who {
    color: #f0d9a8;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .ask-url {
    flex: 1;
    min-width: 0;
    color: #e0e0e0;
    font-size: 12px;
    font-family: monospace;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ask-why {
    flex: 1;
    min-width: 0;
    color: #c8b48a;
    font-size: 11px;
  }

  .danger-l .link-t { color: #f0716c; }

  .allow {
    padding: 4px 16px;
    background: #3d8f63;
    border-radius: 6px;
    cursor: pointer;
  }

  .allow:hover { background: #47a572; }
  .allow-t { color: #ffffff; font-size: 12px; font-weight: 700; }
  .warn-t { color: #e8a54b; }

  .browser-chip {
    padding: 1px 8px;
    border: 1px solid #333333;
    border-radius: 4px;
    cursor: pointer;
  }

  .browser-t { color: #8a8a8a; font-size: 11px; }
  .browser-chip.on { border: 1px solid #3a3550; }
  .browser-chip.on .browser-t { color: #c8c0f8; }
  .b-row { display: flex; gap: 8px; align-items: center; padding: 8px 2px; cursor: pointer; }
  .b-box { color: #c8c0f8; font-size: 16px; }
  .b-t { color: #d4d4d4; font-size: 13px; }
  .b-actions { display: flex; gap: 10px; align-items: center; justify-content: flex-end; padding: 6px 0; }
  .c-row { display: flex; gap: 10px; padding: 3px 2px; }
  .c-where { width: 170px; flex-shrink: 0; color: #7a7a7a; font-size: 12px; font-family: monospace; overflow-wrap: break-word; }
  .c-kv { flex: 1; min-width: 0; color: #d4d4d4; font-size: 12px; font-family: monospace; word-break: break-all; }
  .c-meta { flex-shrink: 0; color: #7a7a7a; font-size: 11px; }

  .agents {
    padding: 1px 8px;
    border: 1px solid #2e5a43;
    border-radius: 4px;
    cursor: pointer;
  }

  .agents-t { color: #4ec98f; font-size: 11px; }
  .agents.off { border: 1px solid #6b2a28; background: #3a1d1c; }
  .agents.off .agents-t { color: #f0716c; }

  .status {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 26px;
    padding: 0 12px;
    background: #181818;
    border-top: 1px solid #262626;
  }

  .dot { font-size: 10px; }

  .status-t.key {
    color: #8a8a8a;
    padding: 1px 6px;
    background: #262626;
    border-radius: 4px;
  }

  .scrim {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 90px;
    background: rgba(0, 0, 0, 0.5);
  }

  .palette {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 540px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 10px;
    background: #1e1e1e;
    border: 1px solid #333333;
    border-radius: 10px;
  }

  .pal-field {
    display: flex;
    align-items: center;
    height: 38px;
    padding: 0 10px;
    margin-bottom: 6px;
    background: #141414;
    border: 1px solid #2e2e2e;
    border-radius: 6px;
  }

  .cmd {
    display: flex;
    align-items: center;
    padding: 8px 10px;
    border-radius: 6px;
    cursor: pointer;
  }

  .cmd:hover { background: #262626; }
  .cmd.on { background: #2b2540; }
  .cmd-label { flex: 1; color: #d4d4d4; font-size: 13px; }
  .cmd-hint { color: #7a7a7a; font-size: 11px; font-family: monospace; }

  .prompt-h {
    color: #f0f0f0;
    font-size: 13px;
    font-weight: 700;
    padding: 2px 4px 8px 4px;
  }

  .prompt-hint {
    color: #7a7a7a;
    font-size: 11px;
    font-family: monospace;
    padding: 2px 4px;
  }

  .status-t { color: #b0b0b0; font-size: 11px; white-space: nowrap; }

  .status-t.flow-t {
    min-width: 0;
    color: #4ec98f;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .status-t.flow-t.bad { color: #f0716c; }

  .bench {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 6px;
  }

  .bench-form { display: flex; gap: 8px; align-items: flex-end; }

  .bf {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 110px;
  }

  .bf-l { color: #7a7a7a; font-size: 11px; }

  .bf-in {
    height: 34px;
    background: #1e1e1e;
    border: 1px solid #2e2e2e;
    border-radius: 6px;
    padding: 0 8px;
  }

  .bench-in { display: flex; flex-direction: column; gap: 10px; }
  .tiles { display: flex; gap: 8px; flex-wrap: wrap; }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 84px;
    padding: 8px 10px;
    background: #1a1a1a;
    border: 1px solid #262626;
    border-radius: 6px;
  }

  .tile-v {
    color: #f0f0f0;
    font-size: 16px;
    font-weight: 700;
    font-family: monospace;
    white-space: nowrap;
  }

  .tile-v.bad { color: #f0716c; }
  .tile-l { color: #7a7a7a; font-size: 11px; }
  .plots { display: flex; gap: 12px; flex-wrap: wrap; }
  .plot-box { display: flex; flex-direction: column; gap: 4px; }
  .plot-box.grow { flex: 1; min-width: 320px; }

  .plot {
    width: 360px;
    height: 100px;
    background: #0e0e0e;
    border: 1px solid #262626;
    border-radius: 6px;
  }

  .line {
    stroke: #4ec98f;
    stroke-width: 2px;
    stroke-linejoin: round;
    fill: none;
  }

  .hist {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 100px;
    padding: 4px 6px 0 6px;
    background: #0e0e0e;
    border: 1px solid #262626;
    border-radius: 6px;
  }

  .hcol {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
    min-width: 0;
  }

  .hbar { width: 100%; background: #7c6cf0; border-radius: 2px 2px 0 0; }
  .hn { color: #b0b0b0; font-size: 9px; font-family: monospace; }

  .hl {
    color: #6a6a6a;
    font-size: 9px;
    font-family: monospace;
    white-space: nowrap;
  }

  .gql-m { display: flex; align-items: center; padding: 0 14px; }
  .gql-t { color: #e535ab; font-size: 14px; font-weight: 700; }
  .schema { flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; gap: 10px; padding-top: 6px; }
  .schema-h { display: flex; gap: 10px; align-items: center; }
  .hsearch.grow { flex: 1; }
  .gtype { display: flex; flex-direction: column; gap: 3px; padding: 8px 10px; background: #1a1a1a; border: 1px solid #262626; border-radius: 6px; }
  .gtype-h { display: flex; gap: 8px; align-items: baseline; }
  .gkind { color: #7a7a7a; font-size: 11px; font-family: monospace; }
  .gname { color: #e535ab; font-size: 13px; font-weight: 700; font-family: monospace; }
  .groot { color: #4ec98f; font-size: 11px; }
  .gdesc { color: #8a8a8a; font-size: 11px; }
  .gfield { display: flex; gap: 6px; padding-left: 12px; }
  .gf-n { color: #d4d4d4; font-size: 12px; font-family: monospace; }
  .gf-a { color: #7a7a7a; font-size: 12px; font-family: monospace; }
  .gf-t { color: #79b8ff; font-size: 12px; font-family: monospace; }
  .gvals { color: #b0b0b0; font-size: 12px; font-family: monospace; padding-left: 12px; }
  .stream { display: flex; flex-direction: column; gap: 4px; }
  .compose { display: flex; gap: 10px; align-items: center; padding-bottom: 6px; }
  .msg { display: flex; gap: 8px; align-items: baseline; padding: 3px 0; border-bottom: 1px solid #1f1f1f; }
  .msg-d { color: #4ec98f; font-size: 13px; font-weight: 700; width: 12px; }
  .msg-d.out { color: #e8a54b; }
  .msg-n { color: #6a6a6a; font-size: 11px; font-family: monospace; width: 34px; }
  .msg-at { color: #6a6a6a; font-size: 11px; font-family: monospace; }
  .msg-ev { color: #b09cf5; font-size: 11px; font-family: monospace; padding: 0 5px; background: #2b2540; border-radius: 4px; }
  .msg-by { color: #8a8a8a; font-size: 11px; }
  .msg-t { color: #d4d4d4; font-size: 12px; font-family: monospace; white-space: pre-wrap; flex: 1; }
  .msg-t.bin { color: #8a8a8a; }
  /* In a scrolling column, parts keep their height and the column scrolls,
     rather than each shrinking to fit as flex items do. */
  .bench-form, .bench-in, .bench > .empty, .until-h, .gtype, .schema-h { flex-shrink: 0; }

  .until-h { padding-top: 14px; border-top: 1px solid #262626; }
  .bf.wide { width: 240px; }

  .u-row {
    display: flex;
    gap: 12px;
    align-items: center;
    padding: 3px 6px;
    border-radius: 4px;
    cursor: pointer;
  }

  .u-row:hover { background: #232323; }
  .u-id { width: 56px; color: #7a7a7a; font-size: 12px; font-family: monospace; }
  .u-mark { width: 12px; color: #6a6a6a; font-size: 12px; }
  .u-mark.on { color: #f0716c; }
  .u-end { flex: 1; min-width: 0; color: #d4d4d4; font-size: 12px; font-family: monospace; }
  .u-streak { color: #7a7a7a; font-size: 12px; font-family: monospace; }
  .cmp-bar { display: flex; gap: 10px; align-items: center; padding-top: 6px; }
  .cmp-pick { width: 200px; }
  .cmp { display: flex; flex-direction: column; gap: 2px; padding: 8px 10px; background: #1a1a1a; border: 1px solid #262626; border-radius: 6px; }
  .cmp-row { display: flex; gap: 12px; align-items: baseline; }
  .cmp-l { width: 80px; color: #8a8a8a; font-size: 12px; }
  .cmp-v { width: 170px; color: #d4d4d4; font-size: 12px; font-family: monospace; }
  .cmp-v.head, .cmp-c.head { color: #8a8a8a; font-family: sans-serif; }
  .cmp-c { color: #b0b0b0; font-size: 12px; font-family: monospace; }
  .cmp-c.bad { color: #f0716c; }
  .cmp-c.good { color: #4ec98f; }
  .status-t.policy-bad {
    min-width: 0;
    color: #f0716c;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .status-t.dim {
    flex: 1;
    min-width: 0;
    color: #6a6a6a;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>

<script>
  use native::tracer;
  use type native::tracer::CoreEvent;
  use type native::tracer::Header;
  use type native::tracer::Saved;
  use type native::tracer::Env;
  use type native::tracer::Var;
  use type native::tracer::Check;
  use type native::tracer::BenchNow;
  use type native::tracer::Comparison;
  use type native::tracer::GSchema;
  use type native::tracer::GType;
  use type native::tracer::CookieRow;
  use native::view;
  use type native::view::BodyLine;

  // One request as the core described it: started, then finished or failed.
  type Row = {
    id: int,
    method: string,
    url: string,
    actor: string,
    actorKind: string,
    state: string,
    status: int,
    ttfbMs: float,
    totalMs: float,
    // Each phase's own length, or -1 where it wasn't measured.
    dnsMs: float,
    connectMs: float,
    tlsMs: float,
    size: int,
    body: string,
    resHeaders: Header[],
    error: string,
    cancelledBy: string,
    env: string,
    // The request as it was written, for Edit and Re-run.
    reqHeaders: Header[],
    reqBody: string,
    // The request this one sent again, or 0.
    rerunOf: int,
    // Why it waits for a person, while `state` is "approval".
    reason: string,
    // When it was sent, in milliseconds since 1970.
    atMs: int,
    // Its expectations as written, and how they came out once checked.
    reqChecks: string,
    results: Check[],
    // The flow it was a step of, or 0.
    flow: int,
    // The bench it was the first request of, or 0.
    bench: int,
    // Its stream's kind ("websocket" or "sse"), or "" if it isn't one;
    // whether it's open; once closed, why and how many went each way.
    stream: string,
    open: bool,
    closedWhy: string,
    msgIn: int,
    msgOut: int
  };

  // One message on a stream, either way. Kept apart from the rows, so a
  // busy stream doesn't rebuild them all for each one.
  type Msg = {
    rid: int,
    n: int,
    dir: string,
    text: string,
    event: string,
    by: string,
    atMs: int,
    binary: bool
  };
  let msgs: Msg[] = signal([]);
  // The most of a stream's messages shown at once, newest first.
  let MSGS_SHOWN = 500;
  // What's typed to send on the open WebSocket on show.
  let wsText = signal("");

  type Client = { client: int, actor: string, actorKind: string };

  // The picker's entry for sending with no environment.
  let NO_ENV = "No environment";

  let methods = ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "WEBSOCKET"];
  let method = signal("GET");
  let url = signal("https://jsonplaceholder.typicode.com/todos/1");
  let body = signal("");
  // The body the other side of the Realtime switch had: a WebSocket's
  // messages are not a request body, so each mode keeps its own.
  let otherBody = signal("");
  let headerText = signal("Accept: application/json");
  // Expectations, one a line; saved as `# @expect` lines.
  let checksText = signal("");
  let reqTab = signal("body");
  let resTab = signal("body");
  let error = signal("");

  // The layout, kept in the app's settings so it outlives the window.
  let sideWidth: float = signal(settings.get("sideWidth") ?? 300.0);
  let reqHeight: float = signal(settings.get("reqHeight") ?? 110.0);
  let dragFrom: float = signal(0.0);

  type Cmd = { id: string, label: string, hint: string };

  let commands: Cmd[] = [
    { id: "send", label: "Send the request", hint: "Ctrl+Enter" },
    { id: "save", label: "Save the request", hint: "Ctrl+S" },
    { id: "save-as", label: "Save the request as…", hint: "" },
    { id: "new", label: "New request", hint: "" },
    { id: "delete", label: "Delete the open request", hint: "" },
    { id: "reload-saved", label: "Reload the saved requests", hint: "" },
    { id: "envs", label: "Edit environments", hint: "" },
    { id: "cancel", label: "Cancel the request on show", hint: "" },
    { id: "newest", label: "Open the newest request", hint: "" },
    { id: "rerun", label: "Re-run the request on show, as it was sent", hint: "" },
    { id: "edit-past", label: "Edit the request on show", hint: "" },
    { id: "curl-sel", label: "Copy the request on show as cURL", hint: "" },
    { id: "flow", label: "Run the open request's folder as a flow", hint: "" },
    { id: "bench", label: "Bench the request being edited", hint: "" },
    { id: "bench-stop", label: "Stop the bench on show", hint: "" },
    { id: "bench-baseline", label: "Save the bench on show as a baseline", hint: "" },
    { id: "mode:bench", label: "Show the bench", hint: "" },
    { id: "mode:rest", label: "Show responses", hint: "" },
    { id: "graphql", label: "Make the request GraphQL", hint: "" },
    { id: "realtime", label: "Make the request a WebSocket", hint: "" },
    { id: "close-stream", label: "Close the stream on show", hint: "" },
    { id: "rest", label: "Make the request REST", hint: "" },
    { id: "schema", label: "Load the GraphQL server's schema", hint: "" },
    { id: "curl-editor", label: "Copy the request being edited as cURL", hint: "" },
    { id: "clear-filter", label: "Clear the history filter", hint: "" },
    { id: "allow", label: "Allow the agent's request on show", hint: "" },
    { id: "refuse", label: "Refuse the agent's request on show", hint: "" },
    { id: "agents-off", label: "Stop all agents (kill switch)", hint: "" },
    { id: "agents-on", label: "Let agents act again", hint: "" },
    { id: "req:body", label: "Edit the request body", hint: "" },
    { id: "req:headers", label: "Edit the request headers", hint: "" },
    { id: "res:body", label: "Show the response body", hint: "" },
    { id: "res:headers", label: "Show the response headers", hint: "" },
    { id: "layout", label: "Reset the layout", hint: "" },
    { id: "reconnect", label: "Reconnect to the core", hint: "" }
  ] + methods.map(m => { id: `method:${m}`, label: `Set the method to ${m}`, hint: "" });

  // Saved requests, as the core's list and its events say. `asOf` is the
  // event number the list was true at; 0 until it has come.
  let saved: Saved[] = signal([]);
  let skipped: string[] = signal([]);
  let asOf = signal(0);
  // Saves and deletes waiting to be applied; see the effect below.
  let inbox: CoreEvent[] = signal([]);

  // The saved request in the editor, by path; "" for one not saved yet.
  let openPath = signal("");
  let notice = signal("");
  // A request clicked while there were unsaved edits: a second click opens it.
  let pendingOpen = signal("");
  let naming = signal(false);
  let saveName = signal("");

  let envs: Env[] = signal([]);
  let envSkipped: string[] = signal([]);
  // The environments panel: the one being edited, its variables as draft
  // rows (saved with "Save variables"), and a secret being set.
  type DraftVar = { id: int, name: string, value: string };
  let editingEnvs = signal(false);
  let editEnv = signal("");
  let draftVars: DraftVar[] = signal([]);
  let nextVarId = signal(1);
  let newEnvName = signal("");
  let secretName = signal("");
  let secretValue = signal("");

  // The environment requests are sent with, remembered across launches.
  let envPick = signal(settings.get("env") ?? NO_ENV);

  let palette = signal(false);
  let search = signal("");
  let pick = signal(0);

  let requests: Row[] = signal([]);
  let clients: Client[] = signal([]);
  let selected = signal(0);
  let lastSeq = signal(0);
  // The kill switch, as the core's events last left it.
  let agentsOn = signal(true);
  // Why agents.policy, as last changed, was not taken; "" when it was.
  let policyError = signal("");
  // The latest flow, as its events last told it, and whether it's well.
  let lastFlow = signal("");
  let flowOk = signal(true);

  // What the work area shows under the editor: responses, or the bench.
  let mode = signal("rest");

  // A GraphQL request is method GRAPHQL, its body the query and then, after
  // a blank line, its variables; they're edited apart and joined here.
  let gqlQuery = signal("");
  let gqlVars = signal("");
  // Under a GraphQL request: its response, or the server's schema.
  let gqlView = signal("response");
  let schema: GSchema? = signal(none);
  let schemaQ = signal("");
  let schemaNote = signal("");
  // The introspection request whose answer becomes the schema, or 0.
  let schemaFor = signal(0);
  // The next bench's plan, as typed; blank is no limit.
  let bTotal = signal("200");
  let bConc = signal("10");
  let bSecs = signal("");
  let bRate = signal("");
  // The bench on show, the latest started unless one was picked: what it
  // sends, how it stands, and requests a second between its reports.
  let benchId = signal(0);
  let benchMethod = signal("");
  let benchUrl = signal("");
  let benchEnv = signal("");
  let benchBy = signal("");
  let benchPlan = signal("");
  let benchTotal = signal(0);
  let benchDurMs: float = signal(0.0);
  let bn: BenchNow? = signal(none);
  // Baselines, and the comparison of the bench on show with one of them or
  // with an earlier bench (another environment's, say).
  let baselineName = signal("");
  let baselineList: string[] = signal([]);
  let compareWith = signal("—");
  let cmp: Comparison? = signal(none);
  // The bench `cmp` judges.
  let cmpFor = signal(0);
  let cmpNote = signal("");
  let benchRunning = signal(false);
  let benchStopped = signal("");
  // The next run-until's plan, as typed, and the run on show (the latest
  // started): what it sends, how it stands, and its answers, newest first.
  let uStreak = signal("3");
  let uMatch = signal("");
  let uMax = signal("");
  let uGap = signal("");
  let untilId = signal(0);
  let untilMethod = signal("");
  let untilUrl = signal("");
  let untilEnv = signal("");
  let untilBy = signal("");
  let untilPlan = signal("");
  let untilRunning = signal(false);
  let untilSent = signal(0);
  let untilStreak = signal(0);
  let untilReached = signal(false);
  let untilReason = signal("");
  type Answer = { id: int, counted: bool, streak: int };
  let untilAnswers: Answer[] = signal([]);
  let rps: float[] = signal([]);
  let prevDone = signal(0);
  let prevMs: float = signal(0.0);
  // Every bench seen, for showing an older one again.
  type BenchSeen = { id: int, method: string, url: string, env: string, by: string, plan: string, total: int, durMs: float };
  let benches: BenchSeen[] = signal([]);
  // Every bench's latest report and how it ended, and each report's count
  // and time, so one picked later shows its numbers and its line again.
  type BenchLast = { id: int, s: BenchNow, ended: bool, reason: string };
  let benchLast: BenchLast[] = signal([]);
  type Mark = { id: int, done: int, ms: float };
  let marks: Mark[] = signal([]);
  // The latest bench, for the status bar.
  let lastBench = signal("");
  let benchOk = signal(true);

  // The response viewer: the body of request `viewFor`, laid out by native
  // code, the line numbers folded, and how many lines to draw.
  let VIEW_STEP = 1000;
  let viewFor = signal(0);
  let bodyLines: BodyLine[] = signal([]);
  let viewVisible = signal(0);
  let viewError = signal("");
  let folded: int[] = signal([]);
  let viewLimit = signal(VIEW_STEP);

  // History's filter: text, who sent it, and how it ended. The same filter
  // as the core's `History` command, applied to what the window already has.
  let ANYONE = "anyone";
  let ANY_STATUS = "any status";
  let actorKinds = [ANYONE, "window", "cli", "agent"];
  let statusClasses = [ANY_STATUS, "2xx", "3xx", "4xx", "5xx", "failed", "cancelled", "running"];
  let hq = signal("");
  let hActor = signal(ANYONE);
  let hStatus = signal(ANY_STATUS);

  computed connected = (tracer.link?.state ?? "") == "connected";

  // How requests behave like a browser's, as the core has it, the jar, and
  // the panel's draft of the setting.
  let browserOn = signal(false);
  let browserOrigin = signal("");
  let jar: CookieRow[] = signal([]);
  let browserOpen = signal(false);
  let bCookies = signal(false);
  let bOrigin = signal("");
  let browserError = signal("");

  effect {
    if connected { loadBrowser(); }
  }

  async fn loadBrowser() {
    try {
      let b = tracer.browserState();
      browserOn = b.cookies;
      browserOrigin = b.origin;
      jar = b.jar;
    } catch e {
      browserError = e.message;
    }
  }

  fn browserLabel(): string {
    let host = browserOrigin.replace("https://", "").replace("http://", "");
    if browserOn && browserOrigin != "" {
      `cookies · ${host}`
    } else if browserOn {
      "cookies"
    } else if browserOrigin != "" {
      `page ${host}`
    } else {
      "browser off"
    }
  }

  fn openBrowser() {
    bCookies = browserOn;
    bOrigin = browserOrigin;
    browserError = "";
    loadBrowser();
    browserOpen = true;
  }

  fn saveBrowser() {
    try {
      tracer.setBrowser(bCookies, bOrigin);
      browserError = "";
      browserOpen = false;
    } catch e {
      browserError = e.message;
    }
  }

  fn clearJar() {
    try {
      tracer.clearCookies("");
    } catch e {
      browserError = e.message;
    }
  }

  // `session`, or how long until it expires.
  fn cookieEnds(at: int): string {
    if at == 0 { return "session"; }
    let left = intDiv(at - Date.now(), 1000);
    if left < 90 { `ends in ${left} s` } else if left < 5400 { `ends in ${intDiv(left, 60)} min` } else if left < 172800 { `ends in ${intDiv(left, 3600)} h` } else { `ends in ${intDiv(left, 86400)} d` }
  }
  computed compareOptions = ["—", ...baselineList, ...benches.filter(b => b.id != benchId).map(b => `bench ${b.id}`).toReversed()];
  computed cmpRows = cmp?.rows ?? [];
  computed cmpNotes = cmp?.notes ?? [];
  computed cmpBefore = cmp?.before ?? "";
  computed cmpAfter = cmp?.after ?? "";
  computed cmpRegressed = cmp?.regressed ?? false;
  computed cmpVerdict = if cmp == none { "" } else if cmp.regressed { `regressed past ${cmp.tolerancePct} %` } else { `no regression past ${cmp.tolerancePct} %` };
  computed gql = method == "GRAPHQL";
  computed wsMode = method == "WEBSOCKET";
  computed showRes = mode == "rest" && !(gql && gqlView == "schema");
  computed queryRoot = schema?.query ?? "";
  computed mutationRoot = schema?.mutation ?? "";
  computed shownTypes =if schema == none { [] } else { schema.types.filter(t => typeMatches(t, schemaQ.trim().toLowerCase())) };
  computed history = requests.sort((a, b) => b.id - a.id);
  // Agents' requests waiting for this person, oldest first.
  computed waiting = requests.filter(r => r.state == "approval");
  computed shown = history.filter(r => passes(r, hq.trim().toLowerCase(), hActor, hStatus));
  computed filtering = hq.trim() != "" || hActor != ANYONE || hStatus != ANY_STATUS;
  computed sel = requests.find(r => r.id == selected);
  computed selMsgsAll = if sel == none { 0 } else { msgs.filter(m => m.rid == sel.id).length };
  computed selMsgs = if sel == none { [] } else { newest(msgs.filter(m => m.rid == sel.id)) };
  computed current = saved.find(s => s.path == openPath);
  // Unsaved edits to a saved request. A request never saved is a scratch pad.
  computed dirty = if openPath == "" { false } else if current == none { true } else { !sameAs(current) };
  computed envOptions = [NO_ENV] + envs.map(e => e.name);
  computed editSecrets = envs.find(e => e.name == editEnv)?.secrets ?? [];
  // The URL as it will go out with the chosen environment. Only a preview:
  // the core fills it in when sending. Secrets show as dots; the window
  // never has their values.
  computed preview = fillVars(url.trim());
  computed hits = commands.filter(c => c.label.toLowerCase().includes(search.toLowerCase()));

  // The viewer follows the request on show once it has its answer.
  effect {
    let id = sel?.id ?? 0;
    let done = (sel?.state ?? "") == "done";
    if done && id != viewFor {
      viewFor = id;
      folded = [];
      viewLimit = VIEW_STEP;
      loadView();
    }
  }

  async fn loadView() {
    let id = viewFor;
    try {
      let v = await view.bodyView(id, folded, viewLimit);
      if id != viewFor { return; }
      bodyLines = v.lines;
      viewVisible = v.visible;
      viewError = "";
    } catch e {
      if id == viewFor {
        bodyLines = [];
        viewVisible = 0;
        viewError = `could not show the body: ${e.message}`;
      }
    }
  }

  fn toggleFold(no: int) {
    folded = if folded.includes(no) { folded.filter(n => n != no) } else { folded + [no] };
    loadView();
  }

  fn showMore() {
    viewLimit = viewLimit + VIEW_STEP;
    loadView();
  }

  // A new filter starts at its first match.
  effect {
    let q = search;
    pick = 0;
  }

  mounted {
    connect();
  }

  async fn connect() {
    error = "";
    try {
      await tracer.connect(tracer.defaultWorkspace());
    } catch e {
      error = `could not reach the core: ${e.message}`;
      return;
    }
    await loadSaved();
    await loadEnvs();
  }

  async fn loadEnvs() {
    try {
      let list = await tracer.listEnvironments();
      envs = list.environments;
      envSkipped = list.skipped;
      // The remembered pick is from the last workspace opened, which may
      // not have it: then nothing is picked, rather than a send failing.
      if envPick != NO_ENV && !envs.some(e => e.name == envPick) {
        envPick = NO_ENV;
      }
    } catch e {
      error = `could not list the environments: ${e.message}`;
    }
  }

  effect {
    settings.set("env", envPick);
  }

  async fn loadSaved() {
    try {
      let c = await tracer.listRequests();
      saved = c.requests;
      skipped = c.skipped;
      asOf = c.asOf;
    } catch e {
      error = `could not list the saved requests: ${e.message}`;
    }
  }

  // Every event the core publishes arrives here once, in the core's order,
  // replayed from the start of the journal when the window opens.
  effect {
    for e in tracer.events {
      // Numbered with no gaps, so anything at or below the last one seen has
      // been handled: a replay asked for again, or a list seen twice.
      if e.seq <= lastSeq { continue; }
      lastSeq = e.seq;
      if e.kind == "request_started" {
        requests.push({
          id: e.requestId,
          method: e.method,
          url: e.url,
          actor: e.actor,
          actorKind: e.actorKind,
          state: "running",
          status: 0,
          ttfbMs: 0.0,
          totalMs: 0.0,
          dnsMs: -1.0,
          connectMs: -1.0,
          tlsMs: -1.0,
          size: 0,
          body: "",
          resHeaders: [],
          error: "",
          cancelledBy: "",
          env: e.env,
          reqHeaders: e.headers,
          reqBody: e.body,
          rerunOf: e.rerunOf,
          atMs: e.atMs,
          reason: "",
          reqChecks: e.checks,
          results: [],
          flow: e.flow,
          bench: e.bench,
          stream: "",
          open: false,
          closedWhy: "",
          msgIn: 0,
          msgOut: 0
        });
      } else if e.kind == "approval_asked" {
        requests = requests.map(r => if r.id == e.requestId { asked(r, e.reason) } else { r });
      } else if e.kind == "approval_given" {
        // Refused, its `request_failed` follows and settles it.
        if e.allow {
          requests = requests.map(r => if r.id == e.requestId { asked(r, "") } else { r });
        }
      } else if e.kind == "flow_started" {
        lastFlow = `flow ${e.flow}: ${e.path} running`;
        flowOk = true;
      } else if e.kind == "flow_finished" {
        lastFlow = if e.allow { `flow ${e.flow} passed` } else { `flow ${e.flow} failed: ${e.reason}` };
        flowOk = e.allow;
      } else if e.kind == "browser_changed" || e.kind == "cookies_changed" {
        loadBrowser();
      } else if e.kind == "until_started" {
        untilId = e.until;
        untilMethod = e.method;
        untilUrl = e.url;
        untilEnv = e.env;
        untilBy = `${e.actorKind} · ${e.actor}`;
        untilPlan = e.reason;
        untilRunning = true;
        untilSent = 0;
        untilStreak = 0;
        untilReached = false;
        untilReason = "";
        untilAnswers = [];
      } else if e.kind == "until_progress" {
        if e.until == untilId {
          untilSent = e.sent;
          untilStreak = e.n;
          untilAnswers = [{ id: e.requestId, counted: e.allow, streak: e.n }] + untilAnswers;
          if untilAnswers.length > 200 { untilAnswers = untilAnswers.slice(0, 200); }
        }
      } else if e.kind == "until_finished" {
        if e.until == untilId {
          untilRunning = false;
          untilSent = e.sent;
          untilStreak = e.n;
          untilReached = e.allow;
          untilReason = e.reason;
        }
      } else if e.kind == "bench_started" {
        benches.push({
          id: e.bench, method: e.method, url: e.url, env: e.env, by: `${e.actorKind} · ${e.actor}`,
          plan: e.stats.plan, total: e.stats.total, durMs: e.stats.durationMs
        });
        // On show in Bench, without switching to it: a replay or another
        // client's bench mustn't take the window over.
        pickBench(e.bench);
        benchRunning = true;
        lastBench = `bench ${e.bench} running`;
        benchOk = true;
      } else if e.kind == "bench_progress" {
        noteBench(e.bench, e.stats, false, "");
        if e.bench == benchId { tick(e.stats); }
      } else if e.kind == "bench_finished" {
        noteBench(e.bench, e.stats, true, e.reason);
        if e.bench == benchId {
          tick(e.stats);
          benchRunning = false;
          benchStopped = e.reason;
        }
        loadBaselines();
        let ok = e.reason == "" && e.stats.wrong == 0;
        lastBench = if e.reason != "" {
          `bench ${e.bench} ${e.reason}`
        } else {
          `bench ${e.bench}: ${e.stats.done} in ${(e.stats.elapsedMs / 1000.0).toFixed(1)} s, p95 ${ms(e.stats.p95Ms)}, ${e.stats.wrong} wrong`
        };
        benchOk = ok;
      } else if e.kind == "request_checked" {
        requests = requests.map(r => if r.id == e.requestId { withResults(r, e.results) } else { r });
      } else if e.kind == "agents_switched" {
        agentsOn = e.allow;
      } else if e.kind == "policy_changed" {
        policyError = e.error;
      } else if e.kind == "request_finished" || e.kind == "request_failed" || e.kind == "request_cancelled" {
        requests = requests.map(r => if r.id == e.requestId { settle(r, e) } else { r });
        if e.requestId == schemaFor {
          if e.kind == "request_finished" {
            readSchema(e.requestId);
          } else {
            schemaFor = 0;
            schemaNote = if e.kind == "request_failed" { `no schema: ${e.error}` } else { "cancelled" };
          }
        }
      } else if e.kind == "baseline_saved" {
        loadBaselines();
      } else if e.kind == "stream_opened" {
        requests = requests.map(r => if r.id == e.requestId { opened(r, e) } else { r });
        if e.requestId == selected && resTab == "body" { resTab = "messages"; }
      } else if e.kind == "stream_message" {
        msgs.push({
          rid: e.requestId,
          n: e.n,
          dir: e.dir,
          text: e.body,
          event: e.sseEvent,
          by: e.actor,
          atMs: e.atMs,
          binary: e.binary
        });
      } else if e.kind == "stream_closed" {
        requests = requests.map(r => if r.id == e.requestId { closed(r, e) } else { r });
      } else if e.kind == "client_joined" {
        clients.push({ client: e.client, actor: e.actor, actorKind: e.actorKind });
      } else if e.kind == "client_left" {
        clients = clients.filter(c => c.client != e.client);
      } else if e.kind == "request_saved" || e.kind == "request_deleted" {
        // The list covers everything numbered before `asOf`.
        if asOf > 0 && e.seq >= asOf {
          inbox.push(e);
        }
      } else if e.kind == "environment_changed" {
        loadEnvs();
      } else if e.kind == "core_stopping" {
        clients = [];
      }
    }
  }

  // Saves and deletes are applied here rather than in the effect above, which
  // reads the channel: deciding what to do compares them with the editor's
  // fields, and that effect shouldn't depend on what's typed.
  effect {
    if inbox.length > 0 {
      let batch = inbox;
      inbox = [];
      for e in batch {
        applySaved(e);
      }
    }
  }

  fn applySaved(e: CoreEvent) {
    let who = `${e.actorKind} · ${e.actor}`;
    if e.kind == "request_deleted" {
      saved = saved.filter(s => s.path != e.path);
      if e.path == openPath && e.actorKind != "window" {
        notice = `${who} deleted it; Save puts it back`;
      }
      return;
    }
    let s = { path: e.path, method: e.method, url: e.url, headers: e.headers, body: e.body, checks: e.checks };
    let before = saved.find(x => x.path == e.path);
    if e.path == openPath && !sameAs(s) {
      if before == none || sameAs(before) {
        // No edits of our own: follow theirs.
        load(s);
        notice = `updated by ${who}`;
      } else {
        // The dev's edit wins; say what happened.
        notice = `${who} saved this; your unsaved edits are kept`;
      }
    }
    if before == none {
      saved = (saved + [s]).sort((a, b) => if a.path < b.path { -1 } else if a.path > b.path { 1 } else { 0 });
    } else {
      saved = saved.map(x => if x.path == e.path { s } else { x });
    }
  }

  // The query and variables, edited apart, are the body.
  effect {
    let q = gqlQuery;
    let v = gqlVars;
    if method == "GRAPHQL" { body = joinGql(q, v); }
  }

  fn joinGql(q: string, v: string): string {
    if v.trim() == "" { q.trimEnd() } else { `${q.trimEnd()}\n\n${v.trim()}` }
  }

  // A GraphQL body as [query, variables]: the variables are the last
  // paragraph, if it's a JSON object (a query that starts with `{` isn't JSON).
  fn gqlParts(b: string): string[] {
    let all = b.trimEnd();
    let at = all.lastIndexOf("\n\n");
    if at < 0 { return [all, ""]; }
    let rest = all.slice(at).trim();
    if !rest.startsWith("{") { return [all, ""]; }
    try {
      JSON.parse(rest);
      return [all.slice(0, at).trimEnd(), rest];
    } catch e {
      return [all, ""];
    }
  }

  fn splitGql(b: string) {
    let p = gqlParts(b);
    gqlQuery = p[0];
    gqlVars = p[1];
  }

  fn toGraphql() {
    mode = "rest";
    if gql { return; }
    if wsMode { leaveRealtime(); }
    method = "GRAPHQL";
    splitGql(body);
    reqTab = "query";
  }

  fn toRest() {
    mode = "rest";
    if wsMode {
      leaveRealtime();
      method = "GET";
      return;
    }
    if !gql { return; }
    method = "POST";
    reqTab = "body";
  }

  async fn loadBaselines() {
    try {
      baselineList = await tracer.baselineNames();
    } catch e {
      cmpNote = `could not list the baselines: ${e.message}`;
    }
  }

  // Keep the bench on show as a baseline, named as typed (main if not).
  fn saveBaseline() {
    if benchId == 0 || benchRunning { return; }
    let name = if baselineName.trim() == "" { "main" } else { baselineName.trim() };
    try {
      let path = tracer.saveBaseline(benchId, name);
      cmpNote = `bench ${benchId} saved as ${path}`;
    } catch e {
      cmpNote = e.message;
    }
  }

  async fn compareNow() {
    if benchId == 0 || compareWith == "—" { return; }
    let id = benchId;
    try {
      cmp = await tracer.compareBench(id, compareWith);
      cmpFor = id;
      cmpNote = "";
    } catch e {
      cmp = none;
      cmpNote = e.message;
    }
  }

  // A WebSocket: method WEBSOCKET, its body the messages to send once open.
  fn toRealtime() {
    mode = "rest";
    if wsMode { return; }
    method = "WEBSOCKET";
    reqTab = "body";
    let messages = otherBody;
    otherBody = body;
    body = messages;
    if url.startsWith("https://") {
      url = "wss://" + url.slice(8);
    } else if url.startsWith("http://") {
      url = "ws://" + url.slice(7);
    }
  }

  // Out of Realtime: the messages are put aside, the request body the
  // editor had comes back, and the URL is http(s) again.
  fn leaveRealtime() {
    let requestBody = otherBody;
    otherBody = body;
    body = requestBody;
    if url.startsWith("wss://") {
      url = "https://" + url.slice(6);
    } else if url.startsWith("ws://") {
      url = "http://" + url.slice(5);
    }
  }

  fn opened(r: Row, e: CoreEvent): Row {
    let out = r;
    out.stream = e.stream;
    out.open = true;
    out.status = e.status;
    out.resHeaders = e.headers;
    out.ttfbMs = e.ttfbMs;
    out.dnsMs = e.dnsMs;
    out.connectMs = e.connectMs;
    out.tlsMs = e.tlsMs;
    out
  }

  fn closed(r: Row, e: CoreEvent): Row {
    let out = r;
    out.open = false;
    out.closedWhy = e.reason;
    out.msgIn = e.received;
    out.msgOut = e.sent;
    out
  }

  // A stream's messages, newest first, at most MSGS_SHOWN of them.
  fn newest(list: Msg[]): Msg[] {
    let sorted = list.sort((a, b) => b.n - a.n);
    if sorted.length > MSGS_SHOWN { sorted.slice(0, MSGS_SHOWN) } else { sorted }
  }

  // Whether the request on show is a stream still open.
  fn streamOpen(): bool {
    sel != none && sel.stream != "" && sel.open
  }

  fn streamText(r: Row): string {
    let what = if r.stream == "websocket" { "WebSocket" } else { "events" };
    if r.open { `${what} open` } else { `${what} closed` }
  }

  // `14:03:07`, for a message.
  fn clock(atMs: int): string {
    let s = Date.seconds(atMs);
    if s < 10 { `${Date.time(atMs)}:0${s}` } else { `${Date.time(atMs)}:${s}` }
  }

  fn sendWs() {
    if sel == none || wsText == "" { return; }
    try {
      tracer.streamSend(sel.id, wsText);
      wsText = "";
    } catch e {
      error = e.message;
    }
  }

  fn wsKey(e: KeyEvent) {
    if e.key == "Enter" {
      sendWs();
      return false;
    }
  }

  // Ask the server in the URL bar for its schema: an ordinary request,
  // which then shows in History; its answer is read when it comes.
  fn loadSchema() {
    if url.trim() == "" {
      schemaNote = "put the server's URL in the bar first";
      return;
    }
    try {
      let env = if envPick == NO_ENV { "" } else { envPick };
      schemaFor = tracer.send("GRAPHQL", url, sentHeaders(), tracer.introspection(), env, "");
      schemaNote = `asking for the schema (#${schemaFor})…`;
    } catch e {
      schemaNote = e.message;
    }
  }

  fn readSchema(id: int) {
    schemaFor = 0;
    try {
      schema = tracer.graphqlSchema(id);
      schemaNote = "";
    } catch e {
      schemaNote = e.message;
    }
  }

  fn typeMatches(t: GType, q: string): bool {
    q == "" || t.name.toLowerCase().includes(q) || t.fields.some(f => f.name.toLowerCase().includes(q))
  }

  // Whether the editor holds exactly `s`.
  fn sameAs(s: Saved): bool {
    method == s.method && url.trim() == s.url && (body == s.body || (gql && body == normGql(s.body))) && headerLines(sentHeaders()) == headerLines(s.headers)
    && checksText.trim() == s.checks.trim()
  }

  fn load(s: Saved) {
    method = s.method;
    url = s.url;
    body = s.body;
    otherBody = "";
    headerText = headerLines(s.headers);
    checksText = s.checks;
    afterLoad();
  }

  // A request just put in the editor: a GraphQL one is split for editing,
  // and the tabs are the ones its kind has.
  fn afterLoad() {
    if gql {
      splitGql(body);
      if reqTab == "body" { reqTab = "query"; }
      mode = "rest";
    } else if reqTab == "query" || reqTab == "vars" {
      reqTab = "body";
    }
  }

  // A saved GraphQL body as the editor would join it.
  fn normGql(b: string): string {
    let p = gqlParts(b);
    joinGql(p[0], p[1])
  }

  fn fillVars(text: string): string {
    fillIn(text, envPick, "••••")
  }

  // `text` with environment `envName`'s variables filled in, and each secret
  // as `secret` (the window never has their values), or left as written
  // when `secret` is "".
  fn fillIn(text: string, envName: string, secret: string): string {
    let env = envs.find(e => e.name == envName);
    if env == none { return text; }
    let out = text;
    for v in env.vars {
      if env.secrets.includes(v.name) { continue; }
      out = out.replaceAll(`{{${v.name}}}`, v.value).replaceAll(`{{ ${v.name} }}`, v.value);
    }
    if secret != "" {
      for name in env.secrets {
        out = out.replaceAll(`{{${name}}}`, secret).replaceAll(`{{ ${name} }}`, secret);
      }
    }
    out
  }

  // A shell command that sends the request, its variables filled in from
  // `envName`; secrets stay `{{name}}` for whoever runs it to fill.
  fn curlOf(m: string, u: string, headers: Header[], b: string, envName: string): string {
    if m == "GRAPHQL" { return gqlCurl(u, headers, b, envName); }
    let parts = ["curl"];
    if m != "GET" { parts.push(`-X ${m}`); }
    parts.push(shellQuote(fillIn(u.trim(), envName, "")));
    for h in headers {
      parts.push(`-H ${shellQuote(fillIn(`${h.name}: ${h.value}`, envName, ""))}`);
    }
    if b != "" { parts.push(`--data-raw ${shellQuote(fillIn(b, envName, ""))}`); }
    parts.join(" ")
  }

  // A GraphQL request as the JSON POST the core sends.
  fn gqlCurl(u: string, headers: Header[], b: string, envName: string): string {
    let p = gqlParts(b);
    let payload = if p[1] == "" {
      JSON.stringify({ query: p[0] })
    } else {
      `{"query":${JSON.stringify(p[0])},"variables":${p[1]}}`
    };
    let all = if headers.some(h => h.name.toLowerCase() == "content-type") {
      headers
    } else {
      [...headers, { name: "Content-Type", value: "application/json" }]
    };
    curlOf("POST", u, all, payload, envName)
  }

  // In single quotes for a POSIX shell: each ' becomes '"'"'.
  fn shellQuote(s: string): string {
    let q = "'";
    q + s.replaceAll(q, q + "\"" + q + "\"" + q) + q
  }

  fn copyCurl(text: string) {
    clipboard.writeText(text);
    notice = if text.includes("{{") { "copied as cURL; fill in the {{secrets}} it still names" } else { "copied as cURL" };
  }

  fn copySelCurl() {
    if sel == none { return; }
    copyCurl(curlOf(sel.method, sel.url, sel.reqHeaders, sel.reqBody, sel.env));
  }

  fn copyEditorCurl() {
    copyCurl(curlOf(method, url, sentHeaders(), body, if envPick == NO_ENV { "" } else { envPick }));
  }

  // When a request was sent: the time, and the day too if not today.
  fn when(ms: int): string {
    if Date.date(ms) == Date.date(Date.now()) { Date.time(ms) } else { `${Date.date(ms)} ${Date.time(ms)}` }
  }

  fn previewWarning(): string {
    if envPick == NO_ENV { "no environment chosen" } else { `not all defined in ${envPick}` }
  }

  fn headerLines(list: Header[]): string {
    list.map(h => `${h.name}: ${h.value}`).join("\n")
  }

  fn nameOf(path: string): string {
    let parts = path.split("/");
    parts[parts.length - 1]
  }

  fn folderOf(path: string): string {
    let parts = path.split("/");
    parts.slice(0, parts.length - 1).join("/")
  }

  // Opening another request over unsaved edits takes a second click.
  fn guardEdits(target: string): bool {
    if dirty && pendingOpen != target {
      pendingOpen = target;
      notice = `unsaved edits to ${openPath}: Save keeps them, or click again to drop them`;
      return false;
    }
    pendingOpen = "";
    true
  }

  fn openSaved(path: string) {
    if path == openPath || !guardEdits(path) { return; }
    let s = saved.find(x => x.path == path);
    if s == none { return; }
    load(s);
    openPath = path;
    notice = "";
  }

  fn newRequest() {
    if !guardEdits("(new)") { return; }
    openPath = "";
    method = "GET";
    url = "";
    body = "";
    otherBody = "";
    headerText = "";
    checksText = "";
    notice = "";
  }

  fn save() {
    if openPath == "" {
      askName();
    } else {
      saveAs(openPath);
    }
  }

  fn askName() {
    blur();
    saveName = openPath;
    naming = true;
  }

  fn saveAs(path: string) {
    try {
      openPath = tracer.saveRequest(path, method, url, sentHeaders(), body, checksText);
      naming = false;
      notice = "";
      error = "";
    } catch e {
      error = e.message;
    }
  }

  fn deleteOpen() {
    if openPath == "" { return; }
    try {
      tracer.deleteRequest(openPath);
      openPath = "";
      notice = "deleted; what's in the editor is unsaved now";
    } catch e {
      error = e.message;
    }
  }

  async fn openEnvEditor() {
    blur();
    editingEnvs = true;
    // Listed afresh, so a panel opened starts current even if the window
    // missed a change while disconnected.
    await loadEnvs();
    let pick = if envPick != NO_ENV { envPick } else if envs.length > 0 { envs[0].name } else { "" };
    if pick != "" { pickEnv(pick); }
  }

  fn pickEnv(name: string) {
    let e = envs.find(x => x.name == name);
    editEnv = name;
    draftVars = [];
    secretName = "";
    secretValue = "";
    if e != none {
      for v in e.vars {
        // Secrets are listed below, by name only.
        if !e.secrets.includes(v.name) { addVarRow(v.name, v.value); }
      }
    }
  }

  fn addVarRow(name: string, value: string) {
    draftVars.push({ id: nextVarId, name: name, value: value });
    nextVarId += 1;
  }

  fn addVar() {
    addVarRow("", "");
  }

  fn removeVar(id: int) {
    draftVars = draftVars.filter(v => v.id != id);
  }

  // Each change below reaches the panel as `environment_changed`, which
  // lists the environments again, as a change made elsewhere does.
  fn saveEnv() {
    let vars: Var[] = draftVars.filter(v => v.name.trim() != "").map(v => { name: v.name.trim(), value: v.value });
    try {
      editEnv = tracer.saveEnvironment(editEnv, vars);
      error = "";
    } catch e {
      error = e.message;
    }
  }

  fn newEnvKey(e: KeyEvent) {
    if e.key == "Enter" {
      createEnv();
      return false;
    }
  }

  fn createEnv() {
    let name = newEnvName.trim();
    if name == "" { return; }
    try {
      editEnv = tracer.saveEnvironment(name, []);
      draftVars = [];
      newEnvName = "";
      error = "";
    } catch err {
      error = err.message;
    }
  }

  fn deleteEnv() {
    try {
      tracer.deleteEnvironment(editEnv);
      if envPick == editEnv { envPick = NO_ENV; }
      editEnv = "";
      draftVars = [];
    } catch e {
      error = e.message;
    }
  }

  fn setSecret() {
    if secretName.trim() == "" || secretValue == "" { return; }
    try {
      tracer.setSecret(editEnv, secretName.trim(), secretValue);
      secretName = "";
      secretValue = "";
      error = "";
    } catch e {
      error = e.message;
    }
  }

  fn removeSecret(name: string) {
    try {
      tracer.setSecret(editEnv, name, "");
    } catch e {
      error = e.message;
    }
  }

  fn nameKey(e: KeyEvent) {
    if e.key == "Enter" {
      saveAs(saveName);
      return false;
    }
  }

  // The folder of the saved request open in the editor, run as a flow with
  // the chosen environment.
  fn runFolder() {
    let at = openPath.lastIndexOf("/");
    if at <= 0 {
      error = "open a saved request in a folder: the folder runs as a flow";
      return;
    }
    error = "";
    try {
      tracer.runFlow(openPath.substring(0, at), if envPick == NO_ENV { "" } else { envPick });
    } catch e {
      error = `could not run the flow: ${e.message}`;
    }
  }

  fn withResults(r: Row, results: Check[]): Row {
    let out = r;
    out.results = results;
    out
  }

  fn failedChecks(r: Row): int {
    r.results.filter(c => !c.pass).length
  }

  fn checkLines(): int {
    checksText.split("\n").filter(l => l.trim() != "").length
  }

  type Phase = { name: string, ms: float, color: string };

  // Where a finished request's time went, in order: each phase's own
  // length, together the whole of it.
  fn phases(r: Row): Phase[] {
    let out: Phase[] = [
      { name: "DNS", ms: r.dnsMs, color: "#5b8def" },
      { name: "connect", ms: r.connectMs, color: "#e8a54b" }
    ];
    if r.tlsMs >= 0.0 {
      out.push({ name: "TLS", ms: r.tlsMs, color: "#c586c0" });
    }
    let before = r.dnsMs + r.connectMs + Math.max(r.tlsMs, 0.0);
    out.push({ name: "wait", ms: Math.max(r.ttfbMs - before, 0.0), color: "#4ec98f" });
    // A stream's time open is no download; Total tells it.
    if r.stream == "" {
      out.push({ name: "download", ms: Math.max(r.totalMs - r.ttfbMs, 0.0), color: "#9d8ff5" });
    }
    out
  }

  fn ms(v: float): string {
    if v < 10.0 { `${(v * 10.0).round() / 10.0} ms` } else { `${v.round()} ms` }
  }

  fn settle(r: Row, e: CoreEvent): Row {
    let out = r;
    if e.kind == "request_failed" {
      out.state = "failed";
      out.error = e.error;
    } else if e.kind == "request_cancelled" {
      out.state = "cancelled";
      out.cancelledBy = `${e.actorKind} · ${e.actor}`;
    } else {
      out.state = "done";
      out.status = e.status;
      out.ttfbMs = e.ttfbMs;
      out.totalMs = e.totalMs;
      out.dnsMs = e.dnsMs;
      out.connectMs = e.connectMs;
      out.tlsMs = e.tlsMs;
      out.size = e.size;
      out.body = e.body;
      out.resHeaders = e.headers;
    }
    out
  }

  fn send() {
    if !connected {
      error = "not connected to a core";
      return;
    }
    error = "";
    try {
      let env = if envPick == NO_ENV { "" } else { envPick };
      selected = tracer.send(method, url, sentHeaders(), body, env, checksText);
      resTab = "body";
    } catch e {
      error = e.message;
    }
  }

  // Bench the request in the editor, with the plan typed above it.
  fn runBench() {
    if !connected {
      error = "not connected to a core";
      return;
    }
    let total = parseInt(bTotal.trim()) ?? 0;
    let conc = parseInt(bConc.trim()) ?? 10;
    let secs = parseInt(bSecs.trim()) ?? 0;
    let rate = parseFloat(bRate.trim()) ?? 0.0;
    if total <= 0 && secs <= 0 {
      error = "a bench needs Requests, Seconds, or both";
      return;
    }
    error = "";
    try {
      let env = if envPick == NO_ENV { "" } else { envPick };
      tracer.runBench(method, url, sentHeaders(), body, env, checksText, total, conc, secs, rate);
    } catch e {
      error = `could not start the bench: ${e.message}`;
    }
  }

  fn runUntil() {
    if !connected {
      error = "not connected to a core";
      return;
    }
    let streak = parseInt(uStreak.trim()) ?? 3;
    let max = parseInt(uMax.trim()) ?? 0;
    let gap = parseInt(uGap.trim()) ?? 0;
    if streak <= 0 {
      error = "In a row is a number from 1";
      return;
    }
    error = "";
    try {
      let env = if envPick == NO_ENV { "" } else { envPick };
      tracer.runUntil(method, url, sentHeaders(), body, env, checksText, streak, uMatch, max, gap);
    } catch e {
      error = `could not start the run: ${e.message}`;
    }
  }

  fn stopUntil() {
    if untilId == 0 { return; }
    try {
      tracer.stopUntil(untilId);
    } catch e {
      error = e.message;
    }
  }

  fn untilState(): string {
    if untilRunning { return "running"; }
    if untilReached { return `${untilStreak} in a row after ${untilSent} sent`; }
    `ended: ${untilReason}`
  }

  fn untilColor(): string {
    if untilRunning { "#d4d4d4" } else if untilReached { "#4ec98f" } else { "#e8a54b" }
  }

  // How request `id` ended, as its history row says.
  fn answerText(id: int): string {
    let r = requests.find(x => x.id == id);
    if r == none { return ""; }
    if r.state == "failed" { return `no answer: ${r.error}`; }
    if r.state == "done" { return `${r.status} · ${ms(r.totalMs)}`; }
    statusText(r)
  }

  // Show one of the run's answers in REST, as a click in History would.
  fn openAnswer(id: int) {
    selected = id;
    mode = "rest";
  }

  fn stopBench() {
    if benchId == 0 { return; }
    try {
      tracer.stopBench(benchId);
    } catch e {
      error = e.message;
    }
  }

  // Show bench `id` in Bench.
  fn showBench(id: int) {
    if benches.some(x => x.id == id) {
      mode = "bench";
      pickBench(id);
    }
  }

  // Put bench `id` on show, with what its reports so far said.
  fn pickBench(id: int) {
    let b = benches.find(x => x.id == id);
    if b == none || id == benchId { return; }
    benchId = id;
    benchMethod = b.method;
    benchUrl = b.url;
    benchEnv = b.env;
    benchBy = b.by;
    benchPlan = b.plan;
    benchTotal = b.total;
    benchDurMs = b.durMs;
    bn = none;
    benchStopped = "";
    rps = [];
    prevDone = 0;
    prevMs = 0.0;
    for m in marks {
      if m.id == id { rate(m.done, m.ms); }
    }
    let last = benchLast.find(x => x.id == id);
    if last != none {
      bn = last.s;
      benchRunning = !last.ended;
      benchStopped = last.reason;
    }
  }

  fn noteBench(id: int, s: BenchNow, ended: bool, reason: string) {
    benchLast = benchLast.filter(x => x.id != id) + [{ id: id, s: s, ended: ended, reason: reason }];
    marks.push({ id: id, done: s.done, ms: s.elapsedMs });
    if marks.length > 4000 { marks = marks.slice(marks.length - 4000); }
  }

  // A report on the bench on show: its numbers, and requests a second since
  // the one before.
  fn tick(s: BenchNow) {
    rate(s.done, s.elapsedMs);
    bn = s;
  }

  fn rate(done: int, ms: float) {
    let dt = ms - prevMs;
    if dt >= 100.0 {
      rps.push((done - prevDone) * 1000.0 / dt);
      if rps.length > 120 { rps = rps.slice(rps.length - 120); }
      prevDone = done;
      prevMs = ms;
    }
  }

  fn benchState(): string {
    if bn == none { return ""; }
    if benchRunning { return "running"; }
    if benchStopped != "" { return benchStopped; }
    `finished in ${(bn.elapsedMs / 1000.0).toFixed(1)} s`
  }

  fn benchColor(): string {
    if benchRunning { "#d4d4d4" } else if benchStopped != "" || (bn?.wrong ?? 0) > 0 { "#f0716c" } else { "#4ec98f" }
  }

  // How far it has got, 0 to 1: by count, or by time when only that limits it.
  fn benchShare(): float {
    if bn == none { return 0.0; }
    if !benchRunning && benchStopped == "" { return 1.0; }
    let byCount = if benchTotal > 0 { bn.done / benchTotal } else { 0.0 };
    let byTime = if benchDurMs > 0.0 { bn.elapsedMs / benchDurMs } else { 0.0 };
    Math.min(1.0, Math.max(byCount, byTime))
  }

  fn rpsTop(): float {
    rps.reduce((a, v) => Math.max(a, v), 1.0)
  }

  // The reports across the plot's 360 px, at most 120 of them, so a short
  // bench spreads out; the busiest fills its 100 px.
  fn rpsPath(): string {
    let top = rpsTop() * 1.1;
    let step = 360.0 / Math.max(1, Math.min(rps.length - 1, 119));
    let d = "";
    let i = 0;
    for v in rps {
      let y = 96.0 - v / top * 92.0;
      d += if i == 0 { `M 0 ${y}` } else { ` L ${i * step} ${y}` };
      i += 1;
    }
    d
  }

  type Bar = { h: float, n: int, label: string };

  // The histogram from its first bucket with answers to its last.
  fn bars(): Bar[] {
    if bn == none { return []; }
    let first = bn.histogram.findIndex(n => n > 0);
    if first < 0 { return []; }
    let last = first;
    let i = 0;
    for n in bn.histogram {
      if n > 0 { last = i; }
      i += 1;
    }
    let most = bn.histogram.reduce((a, n) => Math.max(a, n), 1);
    let out: Bar[] = [];
    for at in first..last + 1 {
      let n = bn.histogram[at];
      let label = if at < bn.buckets.length { `≤${bn.buckets[at].round()}` } else { "more" };
      out.push({ h: if n > 0 { Math.max(2.0, n / most * 64.0) } else { 0.0 }, n: n, label: label });
    }
    out
  }

  // Whether history's filter lets `r` through. `q` is already lower case.
  fn passes(r: Row, q: string, actor: string, status: string): bool {
    if actor != ANYONE && r.actorKind != actor { return false; }
    if status != ANY_STATUS && statusClass(r) != status { return false; }
    if q == "" { return true; }
    let code = if r.state == "done" { `${r.status}` } else { "" };
    [r.method, r.url, r.env, r.actor, code, `#${r.id}`].some(f => f.toLowerCase().includes(q))
  }

  fn statusClass(r: Row): string {
    if r.state == "approval" { "running" } else if r.state != "done" { r.state } else { `${intDiv(r.status, 100)}xx` }
  }

  fn clearFilter() {
    hq = "";
    hActor = ANYONE;
    hStatus = ANY_STATUS;
  }

  // Send the request on show again, exactly as it was written and with the
  // environment it had; the core does it, so it shows as a re-run for all.
  fn rerun() {
    if sel == none { return; }
    error = "";
    try {
      selected = tracer.rerun(sel.id);
      resTab = "body";
    } catch e {
      error = e.message;
    }
  }

  // Put the request on show into the editor, unsaved, with its environment
  // chosen when it still exists.
  fn editPast() {
    if sel == none || !guardEdits(`#${sel.id}`) { return; }
    let r = sel;
    openPath = "";
    method = r.method;
    url = r.url;
    body = r.reqBody;
    otherBody = "";
    headerText = headerLines(r.reqHeaders);
    checksText = r.reqChecks;
    afterLoad();
    notice = `from #${r.id}`;
    if r.env == "" {
      envPick = NO_ENV;
    } else if envs.some(e => e.name == r.env) {
      envPick = r.env;
    } else {
      notice = `from #${r.id}; its environment ${r.env} is gone`;
    }
  }

  // `r` waiting for a person for `reason`, or running again when "".
  fn asked(r: Row, reason: string): Row {
    let out = r;
    out.state = if reason == "" { "running" } else { "approval" };
    out.reason = reason;
    out
  }

  fn decide(id: int, allow: bool) {
    try {
      tracer.decide(id, allow);
    } catch e {
      error = e.message;
    }
  }

  fn setAgents(allowed: bool) {
    try {
      tracer.setAgents(allowed);
    } catch e {
      error = e.message;
    }
  }

  // Whether the request on show is still running, whoever sent it.
  fn running(): bool {
    sel != none && (sel.state == "running" || sel.state == "approval")
  }

  fn cancel() {
    if sel == none { return; }
    try {
      tracer.cancel(sel.id);
    } catch e {
      error = e.message;
    }
  }

  // `Name: value` lines; blank lines and lines with no colon are skipped.
  fn sentHeaders(): Header[] {
    let out: Header[] = [];
    for line in headerText.split("\n") {
      let at = line.indexOf(":");
      if at > 0 {
        out.push({ name: line.slice(0, at).trim(), value: line.slice(at + 1).trim() });
      }
    }
    out
  }

  fn statusText(r: Row): string {
    if r.state == "running" && r.stream != "" {
      "open"
    } else if r.state == "running" {
      "…"
    } else if r.state == "approval" {
      "approval?"
    } else if r.state == "failed" || r.state == "cancelled" {
      r.state
    } else {
      `${r.status}`
    }
  }

  fn statusColor(r: Row): string {
    if r.state == "running" && r.stream != "" {
      "#4ec98f"
    } else if r.state == "running" || r.state == "cancelled" {
      "#8a8a8a"
    } else if r.state == "failed" || r.status >= 500 {
      "#f0716c"
    } else if r.state == "approval" || r.status >= 400 {
      "#e8a54b"
    } else {
      "#4ec98f"
    }
  }

  fn methodColor(m: string): string {
    if m == "GET" {
      "#4ec98f"
    } else if m == "POST" {
      "#e8a54b"
    } else if m == "PUT" || m == "PATCH" {
      "#5aa8f0"
    } else if m == "DELETE" {
      "#f0716c"
    } else {
      "#b09cf5"
    }
  }

  fn size(n: int): string {
    if n < 1024 {
      `${n} B`
    } else if n < 1024 * 1024 {
      `${intDiv(n, 1024)}.${intDiv(n * 10, 1024) % 10} KB`
    } else {
      `${intDiv(n, 1024 * 1024)}.${intDiv(n * 10, 1024 * 1024) % 10} MB`
    }
  }

  fn linkText(): string {
    let l = tracer.link;
    if l == none {
      "starting"
    } else if l.state == "connected" {
      let who = if l.startedCore { "started by this window" } else { "already running" };
      `core connected · ${who}`
    } else if l.detail != "" {
      `core ${l.state}: ${l.detail}`
    } else {
      `core ${l.state}`
    }
  }

  fn linkColor(): string {
    let s = tracer.link?.state ?? "";
    if s == "connected" { "#4ec98f" } else if s == "connecting" || s == "" { "#e8a54b" } else { "#f0716c" }
  }

  fn resizeSide(e: DragEvent) {
    if e.phase == "start" { dragFrom = sideWidth; }
    sideWidth = clamp(dragFrom + e.totalX, 200.0, 560.0);
    if e.phase == "end" { settings.set("sideWidth", sideWidth); }
  }

  fn resizeReq(e: DragEvent) {
    if e.phase == "start" { dragFrom = reqHeight; }
    reqHeight = clamp(dragFrom + e.totalY, 60.0, 420.0);
    if e.phase == "end" { settings.set("reqHeight", reqHeight); }
  }

  fn clamp(v: float, lo: float, hi: float): float {
    Math.max(lo, Math.min(hi, v))
  }

  fn openPalette() {
    // Drop the caret first, so the palette's autofocus field takes it.
    blur();
    search = "";
    pick = 0;
    palette = true;
  }

  fn closePalette() {
    palette = false;
  }

  // The palette's own taps stop here instead of reaching the scrim's close.
  fn noop() {}

  // On the palette's field, before its own editing: the arrows choose and
  // Enter runs, rather than moving the caret.
  fn paletteKey(e: KeyEvent) {
    let n = hits.length;
    if e.key == "ArrowDown" {
      pick = if n == 0 { 0 } else { (pick + 1) % n };
      return false;
    }
    if e.key == "ArrowUp" {
      pick = if n == 0 { 0 } else { (pick + n - 1) % n };
      return false;
    }
    if e.key == "Enter" {
      if pick < n { run(hits[pick].id); }
      return false;
    }
  }

  fn run(id: string) {
    closePalette();
    if id == "send" {
      send();
    } else if id == "save" {
      save();
    } else if id == "save-as" {
      askName();
    } else if id == "new" {
      newRequest();
    } else if id == "delete" {
      deleteOpen();
    } else if id == "reload-saved" {
      loadSaved();
    } else if id == "envs" {
      openEnvEditor();
    } else if id == "cancel" {
      cancel();
    } else if id == "newest" {
      if history.length > 0 { selected = history[0].id; }
    } else if id == "rerun" {
      rerun();
    } else if id == "curl-sel" {
      copySelCurl();
    } else if id == "flow" {
      runFolder();
    } else if id == "bench" {
      mode = "bench";
      runBench();
    } else if id == "bench-stop" {
      stopBench();
    } else if id == "graphql" {
      toGraphql();
    } else if id == "bench-baseline" {
      mode = "bench";
      saveBaseline();
    } else if id == "realtime" {
      toRealtime();
    } else if id == "close-stream" {
      if streamOpen() { cancel(); }
    } else if id == "rest" {
      toRest();
    } else if id == "schema" {
      toGraphql();
      gqlView = "schema";
      loadSchema();
    } else if id == "mode:bench" {
      mode = "bench";
    } else if id == "mode:rest" {
      mode = "rest";
    } else if id == "curl-editor" {
      copyEditorCurl();
    } else if id == "edit-past" {
      editPast();
    } else if id == "clear-filter" {
      clearFilter();
    } else if id == "allow" || id == "refuse" {
      if sel != none && sel.state == "approval" { decide(sel.id, id == "allow"); }
    } else if id == "agents-off" || id == "agents-on" {
      setAgents(id == "agents-on");
    } else if id.startsWith("req:") {
      reqTab = id.slice(4);
    } else if id.startsWith("res:") {
      resTab = id.slice(4);
    } else if id.startsWith("method:") {
      method = id.slice(7);
    } else if id == "layout" {
      sideWidth = 300.0;
      reqHeight = 110.0;
      settings.set("sideWidth", sideWidth);
      settings.set("reqHeight", reqHeight);
    } else if id == "reconnect" {
      // Connected already, `connect` replays the journal, which this page
      // has; only a lost or closed link is worth it.
      if !connected { connect(); }
    }
  }

  fn onKey(e: KeyEvent) {
    if e.primary && e.key == "k" {
      if palette { closePalette(); } else { openPalette(); }
      return false;
    }
    if e.key == "Escape" && palette {
      closePalette();
      return false;
    }
    if e.key == "Escape" && naming {
      naming = false;
      return false;
    }
    if e.key == "Escape" && editingEnvs {
      editingEnvs = false;
      return false;
    }
    if e.primary && e.key == "s" {
      save();
      return false;
    }
    if e.primary && e.key == "Enter" {
      send();
      return false;
    }
  }

  // The window owns the core when it started it: stop it on the way out.
  // Only here, not in `unmounted`, which a dev build's hot reload also runs:
  // the Rust side and its connection outlive a reload, and `connect` in the
  // next `mounted` finds them.
  fn onClose() {
    tracer.close("window closed");
    true
  }
</script>
